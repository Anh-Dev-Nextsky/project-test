{{ 'section-outfit-finder.css' | asset_url | stylesheet_tag }}
<script type="module" src="{{ 'section-outfit-finder.js' | asset_url }}" defer="defer"></script>
{%- liquid
  assign section_st = section.settings
  assign theme_st = settings
  assign scroll_animation = theme_st.scroll_animation
  assign product_image_ratio = theme_st.product_image_ratio
  assign heading_size = section_st.heading_size
  assign text_alignment = section_st.text_alignment
  assign header_size = ''
  if heading_size == 'small'
    assign header_size = 'h3'
  elsif heading_size == 'large'
    assign header_size = 'h1'
  endif
  assign animate_delay = 25
  assign heading = section_st.title
  assign drawn_underline = section_st.drawn_underline
  assign drawn_underline_type = section_st.drawn_underline_type
  assign drawn_underline_color = section_st.drawn_underline_color
  assign notify_preview = section_st.notify_preview
  assign items_to_show = section_st.items_to_show
  assign max_items_select = section_st.max_items_select
  assign items_per_row = section_st.items_per_row
  assign column_gap = section_st.column_gap
  if column_gap == 'large'
    assign column_gap_slide = 32
    assign column_gap_mb = 24
  elsif column_gap == 'medium'
    assign column_gap_slide = 24
    assign column_gap_mb = 12
  elsif column_gap == 'small'
    assign column_gap_slide = 16
    assign column_gap_mb = 8
  else
    assign column_gap_slide = 0
    assign column_gap_mb = 0
  endif
-%}
{%- capture col_style -%}
  --col-desktop: {{ items_per_row }};--col-number: 2;--gap-desktop: {{ column_gap_slide }}px;--gap: {{ column_gap_mb }}px;--row-gap: {{ column_gap_slide }}px;
{%- endcapture -%}
{%- capture style -%}
  --section-pt: {{ section_st.padding_top }}; --section-pb: {{ section_st.padding_bottom }}; --col-width: clamp(30%, 30vw, 4rem);
{%- endcapture -%}

<div
  class="section color-{{ section_st.color_scheme }} gradient"
  style="{{ style | strip | strip_newlines }}"
>
  <div class="outfit-finder-container">
    {%- if section_st.title != blank or section_st.description != blank or section_st.subheading != blank -%}
      <div
        class="section-header fluid_container text-{{ text_alignment }}"
      >
        {%- if section_st.subheading != blank -%}
          {% if scroll_animation != 'disable' %}
            <motion-effect
              data-animate="fade-up"
              data-animate-delay="{{ animate_delay }}"
              class="block"
            >
          {% endif %}
          <div class="section-subheading h7 mb-sp-1 mb-md-sp-2 subheading_weight fs-big-2">
            {{ section.settings.subheading }}
          </div>
          {% if scroll_animation != 'disable' %}
            </motion-effect>
          {% endif %}
        {%- endif -%}
        {%- if section_st.title != blank -%}
          {% if scroll_animation != 'disable' or drawn_underline %}
            {% assign animate_delay = animate_delay | plus: 50 %}
            <motion-effect
              data-animate="{% if scroll_animation != 'disable' %}fade-up{% else %}highlighted-text{% endif %}"
              data-animate-delay="{{ animate_delay }}"
              class="block"
            >
          {% endif %}
          <h2 class="block section-heading {{ header_size }}">
            {% if drawn_underline %}
              {%- capture squiggle_svg_1 -%}
                <svg viewBox="0 0 184 26" fill="none"><use href="#squiggle-svg-1" /></svg>
              {%- endcapture -%}
              {%- capture squiggle_svg_2 -%}
               <svg viewBox="0 0 186 24" fill="none"><use href="#squiggle-svg-2" /></svg>
              {%- endcapture -%}
              {%- capture squiggle_svg_3 -%}
                 <svg viewBox="0 0 186 24" fill="none"><use href="#squiggle-svg-3" /></svg>
              {%- endcapture -%}
              {%- capture squiggle_svg_4 -%}
                <svg viewBox="0 0 220 20"fill="none"><use href="#squiggle-svg-4" /></svg>
              {%- endcapture -%}
              {%- capture squiggle_svg_5 -%}
                <svg viewBox="0 0 140 24" fill="none" role="presentation" preserveAspectRatio="none"><use href="#squiggle-svg-5" /></svg>
              {%- endcapture -%}
              {%- assign result = heading -%}
              {%- assign parts = result | split: '<em>' -%}
              {%- assign em_count = parts | size | minus: 1 -%}

              {%- for i in (1..em_count) -%}
                {%- assign idx = i | plus: 0 -%}
                {%- assign chunk = parts[idx] | default: '' -%}
                {%- assign text = chunk | split: '</em>' | first | strip_html | strip -%}
                {%- assign len_text = text | size -%}
                {%- capture open_em -%}
                {%- liquid
                  if drawn_underline_type == 'simple_underline'
                    assign svg = squiggle_svg_4 | append: '</em>'
                  elsif drawn_underline_type == 'curve_underline'
                    assign svg = squiggle_svg_5 | append: '</em>'
                  else
                    if len_text <= 4
                      assign svg = squiggle_svg_1 | append: '</em>'
                    elsif len_text <= 6
                      assign svg = squiggle_svg_2 | append: '</em>'
                    else
                      assign svg = squiggle_svg_3 | append: '</em>'
                    endif
                  endif
                -%}
                <em class="highlighted-text relative inline-flex{% if drawn_underline_type == 'simple_underline' %} simple_underline{% endif %} {{ drawn_underline_type }} not-italic" style="--animate-color:{{ drawn_underline_color }}">{{ svg }}</em>
              {%- endcapture -%}
                {%- assign open_em = open_em | remove: '</em>' -%}
                {%- assign heading = heading | replace_first: '<em>', open_em -%}
              {%- endfor -%}
            {% endif %}
            {{- heading -}}
          </h2>
          {% if scroll_animation != 'disable' or drawn_underline %}
            </motion-effect>
          {% endif %}
        {%- endif -%}
        {%- if section_st.description != blank -%}
          {% if scroll_animation != 'disable' %}
            {% assign animate_delay = animate_delay | plus: 50 %}
            <motion-effect
              data-animate="fade-up"
              data-animate-delay="{{ animate_delay }}"
              class="block"
            >
          {% endif %}
          <div class="section-description mt-sp-4 prose">
            {{ section.settings.description }}
          </div>
          {% if scroll_animation != 'disable' %}
            </motion-effect>
          {% endif %}
        {%- endif -%}
      </div>
    {%- endif -%}
    <outfit-finder
      data-section-id="{{ section.id }}"
      data-max-items="{{ max_items_select }}"
      style="{{ col_style | strip | strip_newlines }};--header-spacing-bottom:0px;"
    >
      <div class="outfit-finder flex column-reverse row-1025" style="--col-width: 31%;--gap-desktop:0;--gap:0;">
        <div class="hidden flex-1025 column row-1025 flex-1 overflow-hidden">
          <div class="outfit-finder-collection overflow-y-auto custom-scrollbar{% if request.page_type == 'index' %} border-top{% endif %}">
            {% if section.blocks.size > 0 %}
              <ul class="list-unstyled flex gap-sp-6 row column-1025 content-center">
                {% for block in section.blocks %}
                  {%- liquid
                    assign block_st = block.settings
                    assign card_collection = block_st.collection
                  -%}
                  <li class="collection collection-outfit list-unstyled{% if forloop.index == 1 %} active{% endif %}">
                    <button
                      type="button"
                      class="btn load-collection btn-reset rounded-0 btn-link not-scale-btn"
                      data-url="{{ card_collection.url }}"
                      aria-label="{{ card_collection.title }}"
                    >
                      {% render 'collection-outfit', section: section, card_collection: card_collection, block: block %}
                    </button>
                  </li>
                {%- endfor -%}
              </ul>
            {% else %}
              <ul class="list-unstyled flex gap-sp-6 row column-1025 content-center">
                {% for i in (1..3) %}
                  <li class="collection list-unstyled{% if forloop.index == 1 %} active{% endif %}">
                    <button
                      type="button"
                      class="btn load-collection btn-reset rounded-0 btn-link not-scale-btn"
                      aria-label="{{ 'sections.collection_template.title' | t }}"
                      disabled
                    >
                      {% render 'collection-outfit', section: section %}
                    </button>
                  </li>
                {% endfor %}
              </ul>
            {% endif %}
          </div>
          <div
            class="outfit-finder-list border-left border-right overflow-y-auto custom-scrollbar flex-1 bg-custom relative p-1025-40"
            style="{{ col_style | strip | strip_newlines }};--bg-color-custom: #F2F2F2;"
          >
            <div class="grid grid-cols gap">
              {% if section.blocks.size > 0 %}
                {%- if collection == blank -%}
                  {%- liquid
                    assign first_block = section.blocks | first
                    assign collection = first_block.settings.collection
                  -%}
                {% endif %}
                {%- if collection != blank -%}
                  {%- paginate collection.products by items_to_show -%}
                    {%- for product in collection.products -%}
                      {% render 'card-product',
                        card_product: product,
                        section_id: section.id,
                        class: ' motion-item',
                        indexFor: forloop.index,
                        disable_quickview: true,
                        disable_color_swatches: true,
                        disable_vendor: true,
                        disable_tag: true,
                        disable_rate: true,
                        outfit: 'outfit-desktop-add-',
                        product_outfit: true,
                        enable_motion: false,
                        disable_hover_image: true
                      %}
                    {% else %}
                      <div class="absolute empty-collection text-center left-0 right-0 px-sp-5">
                        <p>No products available in this category.</p>
                      </div>
                    {%- endfor -%}
                    {%- liquid
                      assign all_product = collection.products_count
                      if all_product <= items_to_show
                        assign items_to_show = all_product
                      endif
                      assign cur_page = paginate.current_page | times: 1
                      assign amount_products = items_to_show | times: cur_page
                      if amount_products > all_product
                        assign amount_products = all_product
                      endif
                    -%}
                    {% if all_product > items_to_show and amount_products < all_product %}
                      <loadmore-button
                        class="load-more-sentinel block h-custom w-full"
                        style="--height: 2px;"
                        data-limit="{{ items_to_show }}"
                        data-url="{{ collection.url }}?page={{ paginate.current_page | plus: 1 }}"
                      >
                      </loadmore-button>
                    {% endif %}
                  {%- endpaginate -%}
                {% endif %}
              {% else %}
                {% for i in (1..items_to_show) %}
                  {%- render 'card-product',
                    enable_motion: true,
                    section_id: section.id,
                    class: ' motion-item',
                    indexFor: forloop.index
                  -%}
                {% endfor %}
              {% endif %}
            </div>
          </div>
        </div>
        <div
          class="outfit-finder-selections relative transition col-1025-w-custom bg-custom"
          style="--bg-color-custom: #F2F2F2;"
        >
          <div class="outfit-finder-selections-preview absolute inset-0 overflow-hidden bg-custom z-1 isolation p-1025-sp-3">
            {%- assign show_notify = true -%}
            {%- for product in section_st.product_list -%}
              {%- if product.selected_or_first_available_variant.inventory_quantity > 0
                or product.selected_or_first_available_variant.available == true
              -%}
                {%- assign show_notify = false -%}
                <outfit-preview class="outfit-preview rounded absolute not-rendered" data-id="{{ product.id }}">
                  <div
                    class="item outfit-preview__inner opacity-1 w-custom w-custom-1025 p-sp-4 p-1025-sp-5"
                    style="--width: 17rem;--width-dk: 25rem;"
                  >
                    <div class="preview-image">
                      {%- liquid
                        assign p_media = product.selected_or_first_available_variant.featured_media
                        assign alt_features = p_media.alt | default: product.title | escape
                        assign ratio = '3/4'
                        if product_image_ratio != 'adapt'
                          case product_image_ratio
                            when 'square'
                              assign ratio = '1/1'
                            when 'landscape'
                              assign ratio = '4/3'
                            when 'portrait'
                              assign ratio = '3/4'
                          endcase
                        else
                          if p_media.media_type == 'model'
                            assign ratio = '3/4'
                          else
                            assign ratio = p_media.aspect_ratio
                          endif
                        endif
                      -%}
                      <div class="product__media" style="--aspect-ratio: {{ ratio }};">
                        {%- if p_media -%}
                          {% render 'responsive-image',
                            type: 'product',
                            class: 'product__img featured-image',
                            image: p_media,
                            image_alt: alt_features,
                            disable_lazy_loading: true
                          %}
                        {% else %}
                          {% render 'placeholder-render' %}
                        {% endif %}
                      </div>
                    </div>
                  </div>
                  <div
                    class="item__controls opacity-0 visibility-hidden transition absolute right-sp-3 top-sp-3 bottom-12 flex space-between column"
                  >
                    <button
                      type="button"
                      class="control remove btn-hover-custom pointer transition btn-reset p-0 w-custom h-custom bg-custom color-white flex content-center rounded-50 relative"
                      style="--width: 2.8rem;--height: 2.8rem;--btn-bg: #00000099;;--btn-color: #fff;"
                      aria-label="Remove"
                    >
                      <svg
                        width="8"
                        height="8"
                        viewBox="0 0 14 14"
                        fill="none"
                        class="transition-short will-change icon-zoom"
                      >
                        <use href="#icon-close"></use>
                      </svg>
                    </button>
                    <button
                      type="button"
                      class="control scale-zoom pointer btn-hover-custom transition rounded-50 btn-reset p-0 w-custom h-custom bg-custom color-white flex content-center rounded-50"
                      style="--width: 2.8rem;--height: 2.8rem;--btn-bg: #00000099;;--btn-color: #fff;"
                      aria-label="Scale zoom"
                    >
                      <svg width="10" height="10" viewBox="0 0 10 10" fill="none">
                        <use href="#icon-plus"></use>
                      </svg>
                    </button>
                  </div>
                </outfit-preview>
              {% endif %}
            {%- endfor -%}
            {% if show_notify and notify_preview %}
              <div class="notify-preview text-center absolute left-0 right-0 px-sp-5 px-1025-55">
                <span>{{ notify_preview }}</span>
              </div>
            {% endif %}
            <template class="preview">
              <outfit-preview class="outfit-preview absolute">
                <div
                  class="item outfit-preview__inner w-custom w-custom-1025"
                  style="--width: 17rem;--width-dk: 25rem;"
                >
                  <div class="preview-image"></div>
                </div>

                <button
                  type="button"
                  class="control remove btn-hover-custom pointer transition btn-reset p-0 w-custom h-custom bg-custom color-white flex content-center rounded-50 top-custom right-custom absolute item__controls opacity-0 visibility-hidden"
                  style="--width: 2.8rem;--height: 2.8rem;--btn-bg: #00000099;;--btn-color: #fff;--top-custom: -14px;--right-custom: -14px;"
                  style="--width: 2.8rem;--height: 2.8rem;--btn-bg: #ffffff;;--btn-color: #666666;--top-custom: -14px;--right-custom: -14px;"
                  aria-label="Remove"
                >
                  <svg
                    width="8"
                    height="8"
                    viewBox="0 0 14 14"
                    fill="none"
                    class="transition-short will-change icon-zoom"
                  >
                    <use href="#icon-close"></use>
                  </svg>
                </button>
                <button
                  type="button"
                  class="control scale-zoom btn-hover-custom pointer transition btn-reset p-0 w-custom h-custom bg-custom color-white flex content-center rounded-50 bottom-custom right-custom absolute item__controls opacity-0 visibility-hidden"
                  style="--width: 2.8rem;--height: 2.8rem;--btn-bg: #00000099;;--btn-color: #fff;--bottom-custom: -14px;--right-custom: -14px;"
                  aria-label="Scale zoom"
                >
                  <svg width="28" height="28" fill="none" fill="none">
                    <use href="#icon-zoom-handle"></use>
                  </svg>
                </button>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="10"
                  height="10"
                  fill="none"
                  class="absolute top-custom left-custom item__controls opacity-0 visibility-hidden"
                  style="--top-custom: -5px;--left-custom: -5px;"
                >
                  <rect width="9" height="9" x=".5" y=".5" fill="#fff" stroke="#adadad" rx="1.5"/>
                </svg>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="10"
                  height="10"
                  fill="none"
                  class="absolute bottom-custom left-custom item__controls opacity-0 visibility-hidden"
                  style="--bottom-custom: -5px;--left-custom: -5px;"
                >
                  <rect width="9" height="9" x=".5" y=".5" fill="#fff" stroke="#adadad" rx="1.5"/>
                </svg>
              </outfit-preview>
            </template>
          </div>
          <div class="absolute align-center bottom-0 column custom-scrollbar flex flex-end outfit-finder-footer overflow-auto top-0 w-full">
            <div class="outfit-drawer-mobile hidden-1025 w-full z-10">
              <div class="outfit-drawer-mobile__button py-sp-3 bg-white flex content-center rounded-top border-bottom">
                <button
                  type="button"
                  class="button btn btn-reset not-scale-btn heading-color flex content-center gap-sp-2 rounded-0 w-full"
                  aria-label="{{ 'products.product.add_products' | t }}"
                >
                  {{ 'products.product.add_products' | t }}
                  <span
                    class="toggle-menu mt-3 h-custom inline-flex flex-end align-center"
                  >
                    <svg class="icon icon-down icon-rotate transition-short" width="13" height="7" viewBox="0 0 13 7">
                      <use href="#icon-arrow-down-mb" />
                    </svg>
                  </span>
                </button>
              </div>
              <div class="outfit-finder-mobile transition overflow-hidden h-0 bg-white">
                <div class="outfit-finder-collection-mobile flex h-fit justify-center border-bottom">
                  {% if section.blocks.size > 0 %}
                    <ul class="list-unstyled flex gap-sp-8 gap-1025-sp-6 row column-1025 overflow-x-auto hidden-scrollbar p-sp-4 p-1025-sp-5">
                      {% for block in section.blocks %}
                        {%- liquid
                          assign block_st = block.settings
                          assign card_collection = block_st.collection
                        -%}
                        <li class="collection flex{% if forloop.index == 1 %} active{% endif %}">
                          <button
                            type="button"
                            class="btn load-collection btn btn-reset rounded-0 btn-link"
                            data-url="{{ card_collection.url }}"
                            aria-label="{{ card_collection.title }}"
                          >
                            {% render 'collection-outfit',
                              section: section,
                              card_collection: card_collection,
                              block: block
                            %}
                          </button>
                        </li>
                      {%- endfor -%}
                    </ul>
                  {% else %}
                    <ul>
                      {% for i in (1..5) %}
                        <li
                          {%- if forloop.index == 1 %}
                            class="active"
                          {% endif -%}
                        >
                          <button
                            type="button"
                            class="btn"
                            aria-label="{{ 'sections.collection_template.title' | t }}"
                            disabled
                          >
                            {% render 'collection-outfit', section: section %}
                          </button>
                        </li>
                      {% endfor %}
                    </ul>
                  {% endif %}
                </div>
                <div
                  class="outfit-finder-list-mobile overflow-y-auto bg-custom relative border-bottom"
                  style="--bg-color-custom: #F2F2F2;"
                >
                  <div
                    class="outfit-finder-list-mobile-container grid grid-cols gap p-sp-5"
                    style="--col-number: 2;--gap: 12px;"
                  >
                    {% if section.blocks.size > 0 %}
                      {%- if block_st.collection == blank -%}
                        {%- liquid
                          assign first_block = section.blocks | first
                          assign collection = first_block.settings.collection
                        -%}
                      {% endif %}
                      {%- if collection != blank -%}
                        {%- paginate collection.products by items_to_show -%}
                          {%- for product in collection.products -%}
                            {% render 'card-product',
                              card_product: product,
                              section_id: section.id,
                              class: ' motion-item',
                              indexFor: forloop.index,
                              disable_quickview: true,
                              disable_color_swatches: true,
                              outfit: 'outfit-mobile-add-',
                              outfit_mobile: true,
                              disable_tag: true,
                              disable_rate: true,
                              disable_vendor: true,
                              product_outfit: true,
                              enable_motion: true,
                              disable_hover_image: true
                            %}
                          {% else %}
                            <div class="absolute empty-collection text-center left-0 right-0 px-sp-5">
                              <p>No products available in this category.</p>
                            </div>
                          {%- endfor -%}
                          {%- liquid
                            assign all_product = collection.products_count
                            if all_product <= items_to_show
                              assign items_to_show = all_product
                            endif
                            assign cur_page = paginate.current_page | times: 1
                            assign amount_products = items_to_show | times: cur_page
                            if amount_products > all_product
                              assign amount_products = all_product
                            endif
                          -%}
                          {% if all_product > items_to_show and amount_products < all_product %}
                            <loadmore-button
                              data-limit="{{ items_to_show }}"
                              class="load-more-sentinel block h-custom w-full"
                              style="--height: 2px;"
                              data-url="{{ collection.url }}?page={{ paginate.current_page | plus: 1 }}"
                            >
                            </loadmore-button>
                          {% endif %}
                        {%- endpaginate -%}
                      {% endif %}
                    {% else %}
                      {% for i in (1..items_to_show) %}
                        {%- render 'card-product',
                          enable_motion: true,
                          section_id: section.id,
                          class: ' motion-item',
                          indexFor: forloop.index
                        -%}
                      {% endfor %}
                    {% endif %}
                  </div>
                  <div class="end-anchor h-custom" style="--height: 1px;"></div>
                </div>
              </div>
            </div>
            <div class="w-full absolute bg-linear-outfit z-15 hidden-1025 pointer-none opacity-0"></div>
            <div class="summary summary-outfit transition btn-sumary w-full flex-1025 flex-end px-sp-5 py-sp-4 px-1025-sp-6 py-1025-sp-4 z-1">
              {%- liquid
                assign price = 0
                assign disabled = true
              -%}
              {%- for product in section_st.product_list -%}
                {%- liquid
                  assign current_variant = product.selected_or_first_available_variant
                  assign price = current_variant.price | plus: price
                -%}
              {%- endfor -%}
              <product-form>
                <form
                  method="post"
                  action="{{ routes.cart_add_url }}"
                  accept-charset="UTF-8"
                  enctype="multipart/form-data"
                  novalidate="novalidate"
                  data-type="add-to-cart-form"
                >
                  <input type="hidden" name="form_type" value="product">
                  <input type="hidden" name="utf8" value="✓">
                  <div class="outfit-finder-list">
                    {%- for product in section_st.product_list -%}
                      <div class="variant-select" product-id="{{ product.id }}">
                        {%- if product.selected_or_first_available_variant.inventory_quantity > 0
                          or product.selected_or_first_available_variant.available == true
                        -%}
                          {%- assign disabled = false -%}
                          <input
                            type="hidden"
                            name="items[][id]"
                            value="{{ product.selected_or_first_available_variant.id }}"
                          >
                          <input
                            type="hidden"
                            name="items[][quantity]"
                            class="quantity"
                            value="1"
                            data-price="{{ product.selected_or_first_available_variant.price }}"
                          >
                        {% endif %}
                      </div>
                    {%- endfor -%}
                  </div>
                  <div class="relative w-full w-1025-fit gap-10 row-gap-10 flex content-center wrap">
                    <button
                      type="button"
                      name="clear"
                      class="btn pointer btn-outline transition product_clear_button word-wrap hidden"
                      dir="auto"
                      aria-label="{{ 'products.facets.clear_all' | t }}"
                      style="--btn-bg: #fff;"
                    >
                      <span class="btn-label hidden-on-load transition-short flex content-center">
                        {{ 'products.facets.clear_all' | t }}
                      </span>
                      {%- render 'loader' -%}
                    </button>
                    <button
                      type="submit"
                      name="add"
                      class="btn pointer btn-primary transition product_submit_button product-form__submit word-wrap "
                      dir="auto"
                      aria-label="{{ 'products.product.add_all_to_cart' | t }}"
                      {%- if disabled %}
                        disabled
                      {% endif -%}
                    >
                      <span class="btn-label hidden-on-load transition-short flex content-center">
                        {{ 'products.product.add_all_to_cart' | t }}
                        <span class="dot-total mx-sp-1"> - </span>
                        <span class="price total-price">
                          {% if settings.currency_code_enabled %}
                            {{ price | money_with_currency }}
                          {% else %}
                            {{ price | money }}
                          {% endif %}
                        </span>
                      </span>
                      {%- render 'loader' -%}
                    </button>
                  </div>
                </form>
              </product-form>
            </div>
          </div>
        </div>
      </div>
    </outfit-finder>
  </div>
</div>

