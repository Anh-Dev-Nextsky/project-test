{% liquid
  assign section_st = section.settings
  assign block_st = block.settings

  if section_st.section_width == 'fix_width'
    assign section_width = 'container'
  elsif section_st.section_width == 'full_width'
    assign section_width = 'full-width'
  else
    assign section_width = 'fluid_container'
  endif

  assign heading_size = section_st.heading_size
  assign header_size = ''
  if heading_size == 'small'
    assign header_size = 'h3'
  elsif heading_size == 'large'
    assign header_size = 'h1'
  endif

  assign image_ratio = section_st.image_ratio
  assign ratio = '3/4'
  assign ratio_mobile = '3/4'
  if image_ratio != 'adapt'
    case image_ratio
      when 'square'
        assign ratio = '1/1'
        assign ratio_mobile = '1/1'
      when 'landscape'
        assign ratio = '4/3'
        assign ratio_mobile = '4/3'
      when 'portrait'
        assign ratio = '3/4'
        assign ratio_mobile = '3/4'
    endcase
  else
    if block_st.image != blank
      assign ratio = block_st.image.aspect_ratio
      if block_st.image_mobile != blank
        assign ratio_mobile = block_st.image_mobile.aspect_ratio
      else
        assign ratio_mobile = ratio
      endif
    else
      assign ratio = '3/4'
      assign ratio_mobile = '3/4'
    endif
  endif
%}

{%- capture style -%}
  --section-pt: {{ section_st.padding_top }}; --section-pb: {{ section_st.padding_bottom }};
{%- endcapture -%}

<div
  class="section color-{{ section_st.color_scheme }} gradient"
  style="{{ style | strip | strip_newlines }}"
>
  <div class="{{ section_width }}">
    {% if section.settings.subheading != blank or section.settings.title != blank %}
      <div class="section-header text-{{ section_st.header_alignment }}">
        {% if section.settings.subheading != blank %}
          <div class="section-subheading subheading_weight h7 mb-sp-1 mb-md-sp-2 fs-big-2">
            {{ section.settings.subheading }}
          </div>
        {% endif %}
        {% if section.settings.title != blank %}
          <h2 class="section-heading {{ header_size }}" style="letter-spacing: 0.01rem;">
            {{ section.settings.title }}
          </h2>
        {% endif %}
      </div>
    {% endif %}
    <div class="rounded overflow-hidden">
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          {% liquid
            assign block_st = block.settings
          %}
          <div class="flex-md{% if section_st.image_desktop_position == 'right' %} row-reverse-md{% endif %}">
            <div
              class="banner__media w-custom-md"
              style="--aspect-ratio-mb: {{ ratio_mobile }}; --aspect-ratio: {{ ratio }};--width-md: {{ section_st.desktop_image_width }}%;"
            >
              {% liquid
                assign alt = 'general.image.image_alt_default' | t
                if block_st.image.alt
                  assign alt = block_st.image.alt | escape
                endif
              %}
              {% if block_st.image != blank or block_st.image_mobile != blank %}
                {% render 'responsive-image',
                  type: 'other',
                  image: block_st.image,
                  image_alt: alt,
                  image_mobile: block_st.image_mobile,
                  motion: true,
                  animate: 'zoom-out-small'
                %}
              {% else %}
                {% render 'placeholder-render',
                  type: 'collection-6',
                  class: 'img-placeholder h-full w-full',
                  motion: true,
                  animate: 'zoom-out-small'
                %}
              {% endif %}
            </div>
            <div
              class="flex flex-1 column bg-custom px-custom py-custom justify-content-{{ section_st.content_vertical_alignment }} text-{{ section_st.content_text_alignment }}"
              style="--bg-color-custom: {{ section_st.color_bg }};--padding-inline: {{ section_st.padding_content_inline }};--padding-block: {{ section_st.padding_content_block }};"
            >
              {% if section_st.show_icon %}
                <div
                  class="inline-flex justify-content-{{ section_st.content_text_alignment }} text-color mb-sp-6"
                  style="--color-text: #CAC6B9;"
                >
                  {% render 'icon-quote', custom_width: 75 %}
                </div>
              {% endif %}

              {% if block_st.feedback_sumary != blank %}
                <div class="h5">
                  {{ block_st.feedback_sumary }}
                </div>
              {% endif %}

              <div class="word-break rich__text-m0 fs-big-2 mt-sp-3 mb-sp-6">
                {{ block_st.feedback_quote }}
              </div>

              <div class="inline-flex flex-md-row gap-sp-4 justify-content-{{ section_st.content_text_alignment }}">
                {% if section_st.show_author_image %}
                  <div class="hover-effect block-md shrink-0 align-self-center">
                    <div
                      class="author-image w-custom rounded-custom overflow-hidden"
                      style="--aspect-ratio: 1/1; --width: {{ block_st.image_width }}px; --radius: {{ block_st.border_radius }}%;"
                    >
                      {% if block_st.author_image != blank %}
                        {% render 'responsive-image',
                          image: block_st.author_image,
                          type: 'review',
                          column: 1,
                          padding: 0,
                          animate: 'fade-in'
                        -%}
                      {%- else %}
                        {% render 'placeholder-render' %}
                      {% endif %}
                    </div>
                  </div>
                {% endif %}

                <div class="flex column align-start justify-center">
                  {% liquid
                    assign rating_star = block_st.rating_star
                    assign rating_integer = rating_star | floor
                    assign rating_decimal = rating_star | modulo: 1
                  %}
                  {% if section_st.show_rating != false %}
                    <div
                      class="rating flex mb-sp-2 mb-1025-sp-2 relative me-3"
                      role="img"
                    >
                      <span
                        aria-hidden="true"
                        class="star-rating inline-flex align-center gap"
                        style="--gap: 1px; --gap-desktop: 1px;"
                      >
                        {%- for i in (1..5) -%}
                          <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                            <use href="#icon-rate"></use>
                          </svg>
                        {%- endfor -%}
                      </span>
                      <div
                        class="absolute inset-0 z-1 inline-flex align-center gap"
                        style="--gap: 1px; --gap-desktop: 1px;--rate-color: {{ section_st.rate_color }};"
                      >
                        {%- for i in (1..rating_integer) -%}
                          <svg
                            width="12"
                            height="12"
                            viewBox="0 0 12 12"
                            fill="none"
                            class="rate-color"
                          >
                            <use href="#icon-rate"></use>
                          </svg>
                        {%- endfor -%}
                        {% if rating_decimal == 0.5 %}
                          <svg
                            width="12"
                            height="12"
                            viewBox="0 0 12 12"
                            fill="none"
                            class="half-star rtl-mirror"
                          >
                            <use href="#icon-rate-half"></use>
                          </svg>
                        {% endif %}
                      </div>
                    </div>
                  {% endif %}

                  <div class="flex wrap gap-10 align-center">
                    <span class="word-break author-name">
                      {{ block_st.author_name }}
                    </span>

                    {% if section_st.show_verified_buyer -%}
                      <span class="dark-grey flex gap-5 align-center fs-small">
                        <svg width="14" height="10" viewBox="0 0 16 12" fill="none">
                          <use href="#icon-tick"></use>
                        </svg>
                        <i>{{- 'review.verified_buyer.default' | t -}}</i>
                      </span>
                    {%- endif %}
                  </div>
                </div>
              </div>
            </div>
          </div>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.feedback-product.name",
  "tag": "section",
  "class": "section section-feedback-product",
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  },
  "max_blocks": 1,
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.general"
    },
    {
      "type": "select",
      "id": "section_width",
      "options": [
        {
          "value": "fix_width",
          "label": "t:sections.all.layout.fix_width"
        },
        {
          "value": "stretch_width",
          "label": "t:sections.all.layout.stretch_width"
        },
        {
          "value": "full_width",
          "label": "t:sections.all.layout.full_width"
        }
      ],
      "default": "fix_width",
      "label": "t:sections.all.layout.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "info": "t:sections.all.colors.info",
      "default": "default-color-scheme"
    },
    {
      "type": "header",
      "content": "t:sections.all.content_header.label"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "t:sections.all.content_setting.subheading.label",
      "default": "<p>Loved by 17k+ Customers</p>"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:sections.all.content_setting.heading.label",
      "default": "A Gentler Way to Glow"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "small",
          "label": "t:sections.all.content_header.heading_size.options__3.label"
        },
        {
          "value": "medium",
          "label": "t:sections.all.content_header.heading_size.options__2.label"
        },
        {
          "value": "large",
          "label": "t:sections.all.content_header.heading_size.options__1.label"
        }
      ],
      "default": "medium",
      "label": "t:sections.all.content_header.heading_size.label"
    },
    {
      "type": "select",
      "id": "header_alignment",
      "options": [
        {
          "value": "start",
          "label": "t:sections.all.text_alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.all.text_alignment.options__2.label"
        },
        {
          "value": "end",
          "label": "t:sections.all.text_alignment.options__3.label"
        }
      ],
      "default": "center",
      "label": "t:sections.all.text_alignment.alignment"
    },

    {
      "type": "header",
      "content": "t:sections.all.image.image_setting"
    },
    {
      "type": "select",
      "id": "image_desktop_position",
      "options": [
        {
          "value": "left",
          "label": "t:sections.all.image.desktop_position.left"
        },
        {
          "value": "right",
          "label": "t:sections.all.image.desktop_position.right"
        }
      ],
      "default": "left",
      "label": "t:sections.all.image.desktop_position.label",
      "info": "t:sections.all.image.desktop_position.info"
    },
    {
      "type": "range",
      "id": "desktop_image_width",
      "min": 40,
      "max": 60,
      "step": 1,
      "unit": "%",
      "default": 50,
      "label": "t:sections.all.image.width",
      "info": "t:sections.all.image.info_width"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.all.image.aspect_ratio.adapt"
        },
        {
          "value": "square",
          "label": "t:sections.all.image.aspect_ratio.options__1"
        },
        {
          "value": "portrait",
          "label": "t:sections.all.image.aspect_ratio.options__2"
        },
        {
          "value": "landscape",
          "label": "t:sections.all.image.aspect_ratio.options__3"
        }
      ],
      "default": "adapt",
      "label": "t:sections.all.image.aspect_ratio.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.content_setting.label"
    },
    {
      "type": "color",
      "id": "color_bg",
      "label": "t:sections.review.settings.background_color.label",
      "default": "#F2EFE6"
    },
    {
      "type": "range",
      "id": "padding_content_inline",
      "min": 30,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "t:sections.all.padding.padding_inline.label",
      "info": "t:sections.all.padding.padding_inline.info",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_content_block",
      "min": 30,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "t:sections.all.padding.padding_block.label",
      "info": "t:sections.all.padding.padding_block.info",
      "default": 100
    },
    {
      "type": "select",
      "id": "content_vertical_alignment",
      "options": [
        {
          "value": "start",
          "label": "t:sections.image-with-text.settings.desktop_vertical_alignment.top"
        },
        {
          "value": "center",
          "label": "t:sections.image-with-text.settings.desktop_vertical_alignment.middle"
        },
        {
          "value": "end",
          "label": "t:sections.image-with-text.settings.desktop_vertical_alignment.bottom"
        }
      ],
      "default": "center",
      "label": "t:sections.image-with-text.settings.vertical_alignment"
    },
    {
      "type": "select",
      "id": "content_text_alignment",
      "options": [
        {
          "value": "start",
          "label": "t:sections.all.text_alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.all.text_alignment.options__2.label"
        },
        {
          "value": "end",
          "label": "t:sections.all.text_alignment.options__3.label"
        }
      ],
      "default": "start",
      "label": "t:sections.all.text_alignment.label"
    },
    {
      "type": "checkbox",
      "id": "show_icon",
      "label": "t:sections.feedback-product.blocks.settings.show_icon",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_author_image",
      "label": "t:sections.feedback-product.blocks.settings.show_author_image",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "default": true,
      "label": "t:sections.review.settings.rating_type.show"
    },
    {
      "type": "checkbox",
      "id": "show_verified_buyer",
      "default": true,
      "label": "t:sections.review.settings.show_verified_buyer.label"
    },
    {
      "type": "color",
      "id": "rate_color",
      "label": "t:sections.review.settings.rate_color.label",
      "default": "#FFB005"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "feedback",
      "name": "t:sections.feedback-product.blocks.group_name",
      "settings": [
        {
          "type": "header",
          "content": "t:sections.feedback-product.blocks.media"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.all.image.label",
          "info": "t:sections.image_card.blocks.info"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "t:sections.all.image.mobile_image",
          "info": "t:sections.image_card.blocks.info"
        },
        {
          "type": "header",
          "content": "t:sections.feedback-product.blocks.content"
        },
        {
          "type": "text",
          "id": "feedback_sumary",
          "label": "t:sections.feedback-product.blocks.settings.feedback_sumary",
          "default": "Summary"
        },
        {
          "type": "textarea",
          "id": "feedback_quote",
          "label": "t:sections.feedback-product.blocks.settings.feedback_quote",
          "default": "You can add text content from press comments, reviews, or testimonials here."
        },
        {
          "type": "image_picker",
          "id": "author_image",
          "label": "t:sections.feedback-product.blocks.settings.author_image"
        },
        {
          "type": "range",
          "id": "image_width",
          "label": "t:sections.all.image.width",
          "default": 100,
          "min": 50,
          "max": 150,
          "step": 5,
          "unit": "px"
        },
        {
          "type": "range",
          "id": "border_radius",
          "min": 0,
          "max": 50,
          "step": 1,
          "unit": "%",
          "label": "t:sections.custom_section.settings.appearance.settings.corner_radius.label",
          "default": 50
        },
        {
          "type": "text",
          "id": "author_name",
          "label": "t:sections.feedback-product.blocks.settings.author_name",
          "default": "Author Name"
        },
        {
          "type": "range",
          "id": "rating_star",
          "min": 1,
          "max": 5,
          "step": 0.5,
          "label": "t:sections.feedback-product.blocks.settings.rating_star",
          "default": 5
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.feedback-product.name",
      "category": "t:sections.group.storytelling",
      "blocks": [
        {
          "type": "feedback"
        }
      ]
    }
  ]
}
{% endschema %}
