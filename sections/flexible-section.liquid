{{ 'flexible-section.css' | asset_url | stylesheet_tag }}
{% liquid
  assign section_st = section.settings

  case section_st.section_width
    when 'fix_width'
      assign section_width = 'container'
    when 'full_width'
      assign section_width = 'full-width'
    else
      assign section_width = 'fluid_container'
  endcase

  assign custom_layout = section_st.custom_layout
  assign vertical_on_mobile = section_st.vertical_on_mobile
  assign height_section = section_st.height_section

  case height_section
    when 'full_screen'
      assign section_height = 'custom-section-h-full_screen'
    when 'small', 'medium', 'large'
      assign section_height = 'h-' | append: height_section | append: ' h-full'
    when 'custom'
      assign section_height = 'h-custom-section'
      assign height_dk = section_st.custom_height
      assign height_mb = height_dk | times: 0.7
    else
      assign section_height = ''
  endcase

  assign horizontal_position = section_st.horizontal_position
  assign vertical_position = section_st.vertical_position
  assign horizontal_alignment = section_st.horizontal_alignment
  assign vertical_alignment = section_st.vertical_alignment

  if custom_layout == 'horizontal'
    if section_st.content_wrap
      assign content_wrap = 'wrap'
    else
      assign content_wrap = 'flex-nowrap'
    endif
  endif

  assign gap = section_st.gap
  assign min_gap = gap | at_most: 20
  assign border_between = section_st.border_between

  if custom_layout == 'vertical'
    assign class_layout = 'column'
    case vertical_position
      when 'top'
        assign class_position = 'flex-start'
      when 'center'
        assign class_position = 'justify-center'
      when 'bottom'
        assign class_position = 'flex-end'
      when 'space_between'
        assign class_position = 'space-between'
    endcase

    case vertical_alignment
      when 'start'
        assign class_alignment = 'align-start'
      when 'center'
        assign class_alignment = 'align-center'
      when 'end'
        assign class_alignment = 'align-end'
    endcase
  else
    if vertical_on_mobile
      assign class_layout = 'row-1025 column'
      case horizontal_position
        when 'top'
          assign class_position = 'flex-start align-1025-start'
        when 'center'
          assign class_position = 'justify-center align-1025-center'
        when 'bottom'
          assign class_position = 'flex-end align-1025-end'
      endcase

      case horizontal_alignment
        when 'start'
          assign class_alignment = 'align-start flex-1025-start'
        when 'center'
          assign class_alignment = 'align-center flex-1025-center'
        when 'end'
          assign class_alignment = 'align-end flex-1025-end'
        when 'space_between'
          assign class_alignment = 'space-between'
      endcase
    else
      assign class_layout = 'row'
      case horizontal_position
        when 'top'
          assign class_position = 'align-start'
        when 'center'
          assign class_position = 'align-center'
        when 'bottom'
          assign class_position = 'align-end'
      endcase

      case horizontal_alignment
        when 'start'
          assign class_alignment = 'flex-start'
        when 'center'
          assign class_alignment = 'justify-center'
        when 'end'
          assign class_alignment = 'flex-end'
        when 'space_between'
          assign class_alignment = 'space-between'
      endcase
    endif
  endif

  assign background_media = section_st.background_media
  assign border_radius_type = section_st.border_radius_type
  assign border_radius_custom = section_st.border_radius_custom
  assign enable_background_overlay = section_st.enable_background_overlay
  if background_media != 'none'
    assign padding_block = section_st.padding_block | default: 50
  else
    assign padding_block = 0
  endif
%}

{%- capture style -%}
  --section-pt: {{ section_st.padding_top }};--section-pb: {{ section_st.padding_bottom }};
  {%- if height_section == 'custom' -%}
    --item-height: clamp({{ height_mb }}px, calc({{ height_mb }}px + ({{ height_dk }} - {{ height_mb }}) * ( (100vw - 360px) / (1440 - 360) ) ),{{ height_dk }}px);
  {%- endif -%}
  {%- if border_radius_type == 'custom' %}--img-rounded: {{ border_radius_custom }}px;{% endif -%}
  --gap: clamp(calc({{ min_gap }} * 1px), calc({{ min_gap }} * 1px + ({{ gap }} - {{ min_gap }}) * var(--responsive-rate)), calc({{ gap }} * 1px));
{%- endcapture -%}
{% capture class %}
section-flexible--wrapper flex row-gap gap {{ class_layout }} {{ class_alignment }} {{ class_position }} custom_layout {{ content_wrap }} overflow-hidden
{% endcapture %}
{% if request.visual_preview_mode %}
  {% render '_preview-flexible-section' %}
{% else %}
  <div
    class="section color-{{ section_st.color_scheme }} gradient relative{%- if border_radius_type == 'custom' %} rounded{% endif %}{% if background_media == 'none' %} not-has-bg-media{% endif %}{% if section_st.show_divider %} border-top{% endif %} overflow-hidden"
    style="{{ style | strip | strip_newlines }}"
  >
    <div class="relative w-full h-full">
      {% if background_media != 'none' %}
        {% render 'background-media', settings_bg: section_st %}
      {% endif %}
      {% if enable_background_overlay %}
        {% render 'overlay', settings_overlay: section_st, layer: '0' %}
      {% endif %}
      <div
        class="flexible-container {{ section_width }} relative overflow-hidden"
      >
        <div
          class="{{ class }} {{ section_height }} section{% if border_between %} enable_border_between{% endif %}"
          style="--section-pt: {{ padding_block }};--section-pb: {{ padding_block }};"
        >
          {% content_for 'blocks' %}
        </div>
      </div>
    </div>
  </div>
{% endif %}

