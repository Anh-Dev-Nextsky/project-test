{%- liquid
  assign section_st = section.settings
  if section_st.section_width == 'fix_width'
    assign section_width = 'container'
  elsif section_st.section_width == 'full_width'
    assign section_width = 'full-width'
  else
    assign section_width = 'fluid_container'
  endif
  assign column_gap_slide = 0
  if section_st.column_gap == 'x-large'
    assign column_gap_slide = 100
    assign column_gap_mb = 16
  elsif section_st.column_gap == 'large'
    assign column_gap_slide = 32
    assign column_gap_mb = 16
  elsif section_st.column_gap == 'medium'
    assign column_gap_slide = 24
    assign column_gap_mb = 12
  elsif section_st.column_gap == 'small'
    assign column_gap_slide = 16
    assign column_gap_mb = 8
  endif
  assign radius_image_class = ''
  assign radius_content_class = ''
  assign has_custom_background = false
  if section_st.background_color != 'rgba(0,0,0,0)' and section_st.background_color != 'transparent' and section_st.background_color != blank and section_st.background_color != '#fff' and section_st.background_color != '#ffffff'
    assign has_custom_background = true
  endif

  if column_gap_slide == 0
    if section_st.desktop_image_width < 100
      if has_custom_background or section_st.background_type == 'image'
        if section_st.image_desktop_position == 'left'
          assign radius_image_class = 'rounded-1025-left rounded-top-mb'
          assign radius_content_class = 'rounded-1025-right rounded-bottom-mb'
        else
          assign radius_image_class = 'rounded-1025-right rounded-top-mb'
          assign radius_content_class = 'rounded-1025-left rounded-bottom-mb'
        endif
      else
        assign radius_image_class = 'rounded'
        assign radius_content_class = 'rounded'
     endif
    else
      assign radius_image_class = 'rounded-top'
       assign radius_content_class = 'rounded-bottom'
    endif
  else
    assign radius_image_class = 'rounded'
    assign radius_content_class = 'rounded'
  endif

  if section_width == 'full-width'
    assign radius_image_class = ''
    assign radius_content_class = ''
  endif 

  assign padding_content_inline = section_st.padding_content_inline
  assign padding_content_block = section_st.padding_content_block
  assign padding_content_class = ''

  if padding_content_inline > 20
    assign padding_content_class = padding_content_class | append: ' px-custom'
  else
    assign padding_content_class = padding_content_class | append: ' x-min-value'
  endif

  if padding_content_block > 24
    assign padding_content_class = padding_content_class | append: ' py-custom'
  else
    assign padding_content_class = padding_content_class | append: ' y-min-value'
  endif

  assign image_ratio = section_st.image_ratio
  if image_ratio != 'adapt'
    case image_ratio
      when 'square'
        assign ratio = '1/1'
      when 'landscape'
        assign ratio = '4/3'
      when 'portrait'
        assign ratio = '3/4'
    endcase
  else
    if section_st.before_image != blank
      assign ratio = section_st.before_image.aspect_ratio
    elsif section_st.after_image != blank
      assign ratio = section_st.after_image.aspect_ratio
    else
      assign ratio = '4/3'
    endif
  endif
-%}
{%- capture style -%}
  --section-pt: {{ section_st.padding_top }}; --section-pb: {{ section_st.padding_bottom }}; --col-width: {{ section_st.desktop_image_width }}%"
  {%- endcapture -%}

{%- capture col_style -%}
    --gap: {{ column_gap_mb }}px;--gap-desktop: {{  column_gap_slide }}px;--padding-inline: {{ section_st.padding_content_inline }};--padding-block: {{ section_st.padding_content_block }};--responsive-min-rate: 0.6";
{%- endcapture -%}

<div
  class="section color-{{ section_st.color_scheme }} gradient section__image-with-text{% if section_st.show_divider %} border-top{% endif %}"
  style="{{ style | strip | strip_newlines }}"
>
  <div class="{{ section_width }}">
    <div
      class="flex wrap gap{% if section_st.image_desktop_position == 'right' %} row-reverse-md{% endif %}"
      style="{{ col_style | strip | strip_newlines }}"
    >
      <div class="image-with-text__media-item w-full col-1025-w-custom">
        <div
          class="testimonial-media relative w-full h-full"
          style="--aspect-ratio: {{ ratio }}"
        >
          <image-comparison class="block">
            <div class="image-container">
              <div
                class="image-before image-comparison absolute w-full h-full object-fit-cover {{ radius_image_class }}"
                style="--aspect-ratio: {{ ratio }}"
              >
                {% if section_st.before_image != blank %}
                  {% liquid
                    assign image_alt = section_st.before_image.alt
                    if image_alt == blank
                      assign image_alt = 'general.image.image_alt_default' | t
                    endif
                  %}
                  {% render 'responsive-image',
                    type: 'banner',
                    container: section_st.section_width,
                    image: section_st.before_image,
                    image_alt: image_alt,
                    motion: true
                  %}
                {% else %}
                  {% render 'placeholder-render', type: 'blog', class: 'img-placeholder' %}
                {% endif %}
                {% if section_st.show_after_before_text %}
                  <span
                    class="text-before absolute left-20 bottom-20 px-sp-5 py-7 z-1 bg-white shadow-glass-2 rounded-30 fs-small"
                  >
                    {{ section_st.before_text }}
                  </span>
                {% endif %}
              </div>
              <div
                class="image-after image-comparison absolute w-full h-full object-fit-cover {{ radius_image_class }}"
                style="--aspect-ratio: {{ ratio }}"
              >
                {% if section_st.after_image != blank %}
                  {% liquid
                    assign image_alt = section_st.after_image.alt
                    if image_alt == blank
                      assign image_alt = 'general.image.image_alt_default' | t
                    endif
                  %}
                  {% render 'responsive-image',
                    type: 'banner',
                    container: section_st.section_width,
                    image: section_st.after_image,
                    image_alt: image_alt,
                    motion: true
                  %}
                {% else %}
                  {% render 'placeholder-render', type: 'blog', class: 'img-placeholder' %}
                {% endif %}
                {% if section_st.show_after_before_text %}
                  <span
                    class="text-after absolute right-sp-5 bottom-20 px-sp-5 py-7 z-1 bg-white shadow-glass-2 rounded-30 fs-small"
                  >
                    {{ section_st.after_text }}
                  </span>
                {% endif %}
              </div>
            </div>
            <div class="slider absolute top-0 bottom-0 w-custom" tabindex="0" style="--width: 1px;">
              <div
                class="handle absolute w-custom h-custom bg-white rounded flex content-center text-color"
                style="--width: 2.6rem;--height: 4.6rem;--img-rounded: 1.5rem;--color-text: #1d1d1f;"
              >
                <svg
                  width="10"
                  height="12"
                  viewBox="0 0 10 12"
                  fill="none"
                >
                  <rect width="2" height="12" rx="1" fill="currentColor"/>
                  <rect x="4" width="2" height="12" rx="1" fill="currentColor"/>
                  <rect x="8" width="2" height="12" rx="1" fill="currentColor"/>
                </svg>
              </div>
            </div>
          </image-comparison>
        </div>
      </div>
      <div class="w-full{% if section_st.desktop_image_width != 100 %} col-1025-remaining{% endif %} flex text-{{ section_st.text_alignment_mobile }} text-md-{{ section_st.text_alignment }} relative">
        {% if has_custom_background and section_st.background_type == 'color' %}
          <div
            class="image-with-text__wrapper w-full flex bg-custom {{ radius_content_class }}"
            style="--bg-color-custom: {{ section_st.background_color }};"
          >
        {% endif %}
        <div class="image-with-text__text-item-inner w-full z-1 align-self-{{ section_st.desktop_vertical_alignment }}{{ padding_content_class }}">
          {% content_for 'blocks' %}
        </div>
        {% if section_st.background_type == 'image' %}
          <div class="image-with-text__background-image w-full h-full absolute inset-0 z-0 {{ radius_content_class }}">
            {% liquid
              assign image_content_class = 'object-fit-cover w-full h-full ' | append: radius_content_class
            %}
            {% if section_st.background_image != blank %}
              {% render 'responsive-image',
                type: 'banner',
                container: section_width,
                image: section_st.background_image,
                image_alt: '',
                motion: false,
                class: image_content_class
              %}
            {% else %}
              {% render 'placeholder-render',
                type: 'collection-6',
                class: 'img-placeholder w-full h-full',
                motion: false
              %}
            {% endif %}
          </div>
        {% endif %}
        {% if has_custom_background and section_st.background_type == 'color' %}</div>{% endif %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.before_after_result.name",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  },
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "heading"
    },
    {
      "type": "subheading"
    },
    {
      "type": "highlight-text"
    },
    {
      "type": "description"
    },
    {
      "type": "button"
    },
    {
      "type": "_countdown_timer"
    },
    {
      "type": "ciration"
    }
  ],
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.before_after_result.how_to_use"
    },
    {
      "type": "header",
      "content": "t:sections.all.general"
    },
    {
      "type": "select",
      "id": "section_width",
      "options": [
        {
          "value": "fix_width",
          "label": "t:sections.all.layout.fix_width"
        },
        {
          "value": "stretch_width",
          "label": "t:sections.all.layout.stretch_width"
        },
        {
          "value": "full_width",
          "label": "t:sections.all.layout.full_width"
        }
      ],
      "default": "fix_width",
      "label": "t:sections.all.layout.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "info": "t:sections.all.colors.info",
      "default": "default-color-scheme"
    },
    {
      "type": "header",
      "content": "t:sections.product_testimonials.blocks.settings.media.before_after_image.label"
    },
    {
      "type": "range",
      "id": "desktop_image_width",
      "min": 40,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50,
      "label": "t:sections.all.image.width",
      "info": "t:sections.all.image.info_width"
    },
    {
      "type": "image_picker",
      "id": "before_image",
      "label": "t:sections.product_testimonials.blocks.settings.media.before_image.label"
    },
    {
      "type": "image_picker",
      "id": "after_image",
      "label": "t:sections.product_testimonials.blocks.settings.media.after_image.label"
    },
    {
      "type": "checkbox",
      "id": "show_after_before_text",
      "label": "t:sections.product_testimonials.blocks.type.image_comparison.show_after_before_text.label",
      "default": true
    },
    {
      "type": "text",
      "id": "before_text",
      "label": "t:sections.before_after_result.before_text.label",
      "default": "t:sections.before_after_result.before_text.default",
      "visible_if": "{{ section.settings.show_after_before_text }}"
    },
    {
      "type": "text",
      "id": "after_text",
      "label": "t:sections.before_after_result.after_text.label",
      "default": "t:sections.before_after_result.after_text.default",
      "visible_if": "{{ section.settings.show_after_before_text }}"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.all.image.aspect_ratio.adapt"
        },
        {
          "value": "square",
          "label": "t:sections.all.image.aspect_ratio.options__1"
        },
        {
          "value": "portrait",
          "label": "t:sections.all.image.aspect_ratio.options__2"
        },
        {
          "value": "landscape",
          "label": "t:sections.all.image.aspect_ratio.options__3"
        }
      ],
      "default": "adapt",
      "label": "t:sections.all.image.aspect_ratio.label"
    },

    {
      "type": "select",
      "id": "image_desktop_position",
      "options": [
        {
          "value": "left",
          "label": "t:sections.all.image.desktop_position.left"
        },
        {
          "value": "right",
          "label": "t:sections.all.image.desktop_position.right"
        }
      ],
      "default": "left",
      "label": "t:sections.all.image.desktop_position.label",
      "info": "t:sections.all.image.desktop_position.info"
    },
    {
      "type": "header",
      "content": "t:sections.all.content_setting.label"
    },

    {
      "type": "select",
      "id": "background_type",
      "label": "t:sections.image-with-text.settings.background_type.label",
      "options": [
        {
          "value": "color",
          "label": "t:sections.image-with-text.settings.background_type.color"
        },
        {
          "value": "image",
          "label": "t:sections.image-with-text.settings.background_type.image"
        }
      ],
      "default": "color"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:sections.image-with-text.settings.background_image",
      "visible_if": "{{ section.settings.background_type == 'image' }}"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:sections.image-with-text.settings.background_color",
      "alpha": true,
      "visible_if": "{{ section.settings.background_type == 'color' }}"
    },
    {
      "type": "select",
      "id": "desktop_vertical_alignment",
      "options": [
        {
          "value": "start",
          "label": "t:sections.image-with-text.settings.desktop_vertical_alignment.top"
        },
        {
          "value": "center",
          "label": "t:sections.image-with-text.settings.desktop_vertical_alignment.middle"
        },
        {
          "value": "end",
          "label": "t:sections.image-with-text.settings.desktop_vertical_alignment.bottom"
        }
      ],
      "default": "center",
      "label": "t:sections.image-with-text.settings.desktop_vertical_alignment.label"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "options": [
        {
          "value": "start",
          "label": "t:sections.all.text_alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.all.text_alignment.options__2.label"
        },
        {
          "value": "end",
          "label": "t:sections.all.text_alignment.options__3.label"
        }
      ],
      "default": "start",
      "label": "t:sections.all.text_alignment.label"
    },
    {
      "type": "select",
      "id": "column_gap",
      "options": [
        {
          "value": "no_gap",
          "label": "t:sections.all.padding.column_gap.no_gap"
        },
        {
          "value": "small",
          "label": "t:sections.all.padding.column_gap.small"
        },
        {
          "value": "medium",
          "label": "t:sections.all.padding.column_gap.medium"
        },
        {
          "value": "large",
          "label": "t:sections.all.padding.column_gap.large"
        }
      ],
      "default": "medium",
      "label": "t:sections.all.padding.column_gap.label"
    },
    {
      "type": "range",
      "id": "padding_content_inline",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:sections.all.padding.padding_inline.label",
      "info": "t:sections.all.padding.padding_inline.info",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_content_block",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:sections.all.padding.padding_block.label",
      "info": "t:sections.all.padding.padding_block.info",
      "default": 40
    },
    {
      "type": "header",
      "content": "t:sections.all.mobile_options.mobile_layout.label"
    },
    {
      "type": "select",
      "id": "text_alignment_mobile",
      "options": [
        {
          "value": "start",
          "label": "t:sections.all.text_alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.all.text_alignment.options__2.label"
        },
        {
          "value": "end",
          "label": "t:sections.all.text_alignment.options__3.label"
        }
      ],
      "default": "start",
      "label": "t:sections.all.text_alignment.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 48
    },
    {
      "type": "header",
      "content": "t:sections.all.divider.section_divider_heading"
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "t:sections.all.divider.show_divider",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "t:sections.before_after_result.name",
      "category": "t:sections.group.banners",
      "blocks": [
        {
          "type": "heading"
        },
        {
          "type": "description"
        },
        {
          "type": "button"
        }
      ]
    }
  ]
}
{% endschema %}
