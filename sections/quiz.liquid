      "label": "t:sections.quiz.settings.email_placeholder.label"
    },
    {
      "type": "text",
      "id": "continue_label",
      "label": "t:sections.quiz.settings.continue_label.label"
    },
    {
      "type": "text",
      "id": "skip_label",
      "label": "t:sections.quiz.settings.skip_label.label"
    },
    {
      "type": "header",
      "content": "t:sections.quiz.settings.results_display_header"
    },
    {
      "type": "image_picker",
