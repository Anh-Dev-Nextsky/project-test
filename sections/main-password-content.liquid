{{ 'page-password.css' | asset_url | stylesheet_tag }}
<script type="module" src="{{ 'password-modal.js' | asset_url }}" defer="defer"></script>

{% liquid
  assign section_st = section.settings
%}

<div
  class="main-password flex h-full-screen content-center"
>
  <div class="main-content section-full flex content-center p-sp-5 p-md-60 bg-white rounded h-fit">
    <div class="max-w-custom">
      <div>
        <div class="password-header flex justify-content-{{ section_st.text_align }}">
          <popup-password
            class="flex gap-sp-4 content-center password-header_logo column"
            data-required="{{ 'customer.validate.password' | t }}"
            data-minlength="{{ 'customer.validate.min_password' | t }}"
          >
            <div class="password-logo flex content-center">
              {%- render 'logo', section_st: section_st -%}
            </div>
            <div class="modal__toggle" aria-haspopup="dialog">
              <div class="modal__toggle-open password-link flex content-center gap-sp-2 pointer">
                {% render 'icon-padlock' %}
                <div class="password-modal__content-heading heading-color lh-global underline" tabindex="0">
                  {{ 'general.password_page.login_password_button' | t }}
                </div>
              </div>
            </div>

            <template>
              <div class="newsletter-popup">
                <password-modal-popup
                  class="modal modal_type_popup active-modal-js modal-newsletter-popup fixed inset-0 z-31 flex align-center invisible"
                >
                  <modal-overlay class="modal-overlay invisible transition-drawer cursor-crosshair"></modal-overlay>
                  <div
                    class="modal-popup-inner invisible modal-focus modal-body modal-draggable transition rounded max-w-custom m-auto w-full bg-white z-15"
                    style="--max-width: 50rem;"
                    tabindex="-1"
                  >
                    <button
                      is="button-close-model"
                      class="modal__close hidden flex-1025 modal-button-close rounded-50 pointer btn-reset wh-58 content-center absolute z-3 top-sp-3 right-sp-3"
                      aria-label="Close"
                    >
                      <svg
                        width="12"
                        height="12"
                        viewBox="0 0 14 14"
                        fill="none"
                        class="transition-short will-change icon-zoom"
                      >
                        <use href="#icon-close"></use>
                      </svg>
                    </button>
                    <div class="drawer__body drawer__body-item h-full">
                      <div
                        class="flex gap"
                      >
                        <draggable-modal
                          class="password-modal__content draggable-modal visible-drag-md drawer-spacing w-full newsletter_content-inner password-page flex column gap-10 gap-md-20 max-h-100 align-self-center overflow-hidden"
                        >
                          <h2 class="password-modal-title text-center fs-20">
                            {{ 'general.password_page.login_form_heading' | t }}
                          </h2>
                          <button
                            is="button-close-model"
                            class="modal__close pointer modal-button-close rounded-50 btn-reset flex hidden-1025 content-center absolute z-3 top-14 right-sp-5"
                            aria-label="Close"
                          >
                            <svg
                              width="12"
                              height="12"
                              viewBox="0 0 14 14"
                              fill="none"
                              class="transition-short will-change icon-zoom"
                            >
                              <use href="#icon-close"></use>
                            </svg>
                          </button>
                          {%- form 'storefront_password', class: 'form-validation password-form-popup' -%}
                            <div class="field relative password-field{% if form.errors %} password-field--error flex column gap-10{% endif %}">
                              <input
                                type="password"
                                name="password"
                                id="Password--storefront"
                                required
                                class="field__input field__input-pass"
                                autocomplete="current-password"
                                {% if form.errors %}
                                  aria-invalid="true"
                                  aria-describedby="PasswordLoginForm-password-error"
                                {% endif %}
                                placeholder="{{ 'general.password_page.login_form_password_placeholder' | t }}"
                              >
                              <label for="Password--storefront" class="field__label">
                                {{ 'customer.login_page.password' | t }} *
                              </label>
                              {%- if form.errors -%}
                                <div
                                  id="PasswordLoginForm-password-error error fs-small inline-flex align-start w-full column"
                                  role="status"
                                >
                                  <span class="visually-hidden">{{ 'accessibility.error' | t }}</span>
                                  <div class="error fs-small inline-flex align-start w-full mt-sp-1">
                                    <svg
                                      width="18"
                                      height="18"
                                      viewBox="0 0 18 18"
                                      fill="none"
                                      class="flex-auto w-18"
                                    >
                                      <use href="#icon-error"></use>
                                    </svg>
                                    {{ 'general.password_page.login_form_error' | t }}
                                  </div>
                                </div>
                              {% endif %}
                            </div>
                            <button
                              class="password-button mt-sp-3 w-full btn btn-primary"
                              aria-label="{{ 'general.password_page.login_form_submit' | t }}"
                            >
                              <span class="hidden-on-load transition-short">
                                {{- 'general.password_page.login_form_submit' | t -}}
                              </span>
                              {%- render 'loader' -%}
                            </button>
                          {%- endform -%}

                          <div class="password__footer-text text-center prose">
                            {{ 'general.password_page.admin_link_html' | t }}
                          </div>
                        </draggable-modal>
                      </div>
                    </div>
                  </div>
                </password-modal-popup>
              </div>
            </template>
          </popup-password>
        </div>
        {%- if shop.password_message != blank -%}
          <div class="password-content">
            {{ shop.password_message }}
          </div>
        {% endif %}
      </div>

      <div
        class="row banner-text--grid"
      >
        <div class="banner-text--content text-{{ section_st.text_align }}">
          <div
            class="password-with-banner banner-text--content-inner"
          >
            {% content_for 'blocks' %}
          </div>
        </div>
      </div>
      <div></div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-password-content.name",
  "tag": "section",
  "class": "h-full",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.main-password-content.how_to_use"
    },
    {
      "type": "header",
      "content": "t:sections.main-password-content.settings.header__2.content"
    },
    {
      "type": "select",
      "id": "text_align",
      "options": [
        {
          "value": "left",
          "label": "t:sections.all.text_alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.all.text_alignment.options__2.label"
        },
        {
          "value": "right",
          "label": "t:sections.all.text_alignment.options__3.label"
        }
      ],
      "default": "left",
      "label": "t:sections.all.text_alignment.alignment"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },

    {
      "type": "subheading"
    },
    {
      "type": "heading"
    },
    {
      "type": "description"
    },
    {
      "type": "_countdown_timer"
    },
    {
      "type": "form-subscribe"
    }
  ]
}
{% endschema %}
