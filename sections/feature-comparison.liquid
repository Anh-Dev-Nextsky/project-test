{% liquid
  assign section_st = section.settings

  if section_st.section_width == 'fix_width'
    assign section_width = 'container'
  elsif section_st.section_width == 'full_width'
    assign section_width = 'full-width'
  else
    assign section_width = 'fluid_container'
  endif

  assign heading_size = section_st.heading_size
  assign header_size = ''
  if heading_size == 'small'
    assign header_size = 'h3'
  elsif heading_size == 'large'
    assign header_size = 'h1'
  endif
%}

{% capture style %}
  --section-pt: {{ section_st.padding_top }}; --section-pb: {{ section_st.padding_bottom }};
{% endcapture %}

{% style %}
  .feature-comparison__table-wrapper {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .feature-comparison__table {
    grid-template-columns: 50% 25% 25%;
    min-width: max-content;
    border-radius: 2rem;
    overflow: hidden;
  }

  .feature-comparison__feature {
    grid-column: 1 / 2;
    padding-inline-start: 1rem;
  }

  .feature-comparison__brand {
    grid-column: 2 / 3;
  }

  .feature-comparison__competitor {
    grid-column: 3 / 4;
  }

  .feature-comparison__feature.last-row,
  .feature-comparison__brand.last-row,
  .feature-comparison__competitor.last-row {
    padding-bottom: 2rem;
  }

  {% if section_st.highlight_brand_column %}
    #shopify-section-{{ section.id }} .feature-comparison__feature,
    #shopify-section-{{ section.id }} .feature-comparison__brand {
      background-color: #ffffff4b;
    }

    #shopify-section-{{ section.id }} .feature-comparison__feature:first-child {
      border-start-start-radius: 2rem;
    }

    #shopify-section-{{ section.id }} .feature-comparison__brand:nth-child(2) {
      border-start-end-radius: 2rem;
    }

    #shopify-section-{{ section.id }} .feature-comparison__feature:nth-last-child(3) {
      border-end-start-radius: 2rem;
    }

    #shopify-section-{{ section.id }} .feature-comparison__brand:nth-last-child(2) {
      border-end-end-radius: 2rem;
    }

    #shopify-section-{{ section.id }} .feature-comparison__feature {
      box-shadow: calc(-8px * var(--flow-direction, 1)) 0 18px rgba(0, 0, 0, 0.06);
    }

    #shopify-section-{{ section.id }} .feature-comparison__brand {
      box-shadow: calc(8px * var(--flow-direction, 1)) 0 18px rgba(0, 0, 0, 0.06);
    }
  {% endif %}

  @media (min-width: 768px) {
    .feature-comparison__table-wrapper {
      overflow-x: visible;
    }

    .feature-comparison__table {
      min-width: 0;
      border-radius: 0;
      overflow: visible;
    }
  }
{% endstyle %}

<div
  class="section color-{{ section_st.color_scheme }} gradient"
  style="{{ style | strip | strip_newlines }}"
  {% if section_st.heading != blank %}
    aria-labelledby="FeatureComparisonHeading-{{ section.id }}"
  {% else %}
    aria-label="{{ 'sections.feature-comparison.name' | t }}"
  {% endif %}
>
  <div class="{{ section_width }} flex-md{% if section_st.desktop_table_position == 'left' %} row-reverse-md{% endif %}">
    <div
      class="feature-comparison__header mb-30 mb-md-0 flex flex-1 column px-custom justify-content-{{ section_st.content_vertical_alignment }} text-{{ section_st.header_alignment }}"
      style="--padding-inline: {{ section_st.padding_content_inline }};"
    >
      {% if section_st.subheading != blank %}
        <div class="section-subheading subheading_weight h7 mb-sp-1 mb-md-sp-2 fs-big-2">
          {{ section_st.subheading }}
        </div>
      {% endif %}

      {% if section_st.heading != blank %}
        <h2
          id="FeatureComparisonHeading-{{ section.id }}"
          class="section-heading {{ header_size }} mb-sp-1 mb-md-sp-5"
        >
          {{ section_st.heading | escape }}
        </h2>
      {% endif %}

      <div class="section-description prose mb-sp-1 mb-md-sp-5">
        {{ section_st.description }}
      </div>

      {% if section_st.show_rating %}
        <div class="flex gap-sp-2 justify-content-{{ section_st.header_alignment }}">
          <div
            class="rating flex relative me-3"
            role="img"
            aria-label="{{ 'sections.feature-comparison.rating_label' | t: rating: section_st.rating_star }}"
          >
            {% liquid
              assign rating_star = section_st.rating_star
              assign rating_integer = rating_star | floor
              assign rating_decimal = rating_star | modulo: 1
            %}
            <span
              aria-hidden="true"
              class="star-rating inline-flex align-center gap"
              style="--gap: 1px; --gap-desktop: 1px;"
            >
              {%- for i in (1..5) -%}
                <svg
                  aria-hidden="true"
                  focusable="false"
                  width="12"
                  height="12"
                  viewBox="0 0 12 12"
                  fill="none"
                >
                  <use href="#icon-rate"></use>
                </svg>
              {%- endfor -%}
            </span>
            <div
              class="absolute inset-0 z-1 inline-flex align-center gap"
              style="--gap: 1px; --gap-desktop: 1px;--rate-color: {{ section_st.rate_color }};"
            >
              {%- for i in (1..rating_integer) -%}
                <svg
                  aria-hidden="true"
                  focusable="false"
                  width="12"
                  height="12"
                  viewBox="0 0 12 12"
                  fill="none"
                  class="rate-color"
                >
                  <use href="#icon-rate"></use>
                </svg>
              {%- endfor -%}
              {% if rating_decimal == 0.5 %}
                <svg
                  aria-hidden="true"
                  focusable="false"
                  width="12"
                  height="12"
                  viewBox="0 0 12 12"
                  fill="none"
                  class="half-star rtl-mirror"
                >
                  <use href="#icon-rate-half"></use>
                </svg>
              {% endif %}
            </div>
          </div>
          <div class="review-text fs-small">
            {{ section_st.review_text }}
          </div>
        </div>
      {% endif %}
    </div>

    <div
      class="feature-comparison__table-wrapper w-custom-md h-fit my-auto"
      style="--width-md: {{ section_st.desktop_table_width }}%;"
    >
      <div
        class="feature-comparison__table grid"
        role="table"
        aria-label="{{ 'sections.feature-comparison.table.label' | t }}"
        aria-rowcount="{{ section.blocks.size | plus: 1 }}"
        aria-colcount="3"
      >
        <div class="feature-comparison__feature" role="columnheader" aria-rowindex="1" aria-colindex="1">
          <div class="feature-comparison__feature-content border-bottom h-full">
            <span class="visually-hidden">
              {{ 'sections.feature-comparison.table.feature_column' | t }}
            </span>
          </div>
        </div>
        <div class="feature-comparison__brand" role="columnheader" aria-rowindex="1" aria-colindex="2">
          <h6
            id="FeatureComparisonBrand-{{ section.id }}"
            class="feature-comparison__brand-content border-bottom py-sp-3 px-sp-1 text-center h-full"
          >
            {{ section_st.brand_label | escape }}
          </h6>
        </div>
        <div class="feature-comparison__competitor" role="columnheader" aria-rowindex="1" aria-colindex="3">
          <h6
            id="FeatureComparisonCompetitor-{{ section.id }}"
            class="feature-comparison__competitor-content border-bottom py-sp-3 px-sp-1 text-center h-full"
          >
            {{ section_st.competitor_label | escape }}
          </h6>
        </div>

        {% for block in section.blocks %}
          {% liquid
            assign block_st = block.settings
            assign row_index = forloop.index | plus: 1
          %}
          <div
            class="feature-comparison__feature{% if forloop.last %} last-row{% endif %}"
            role="rowheader"
            aria-rowindex="{{ row_index }}"
            aria-colindex="1"
            {{ block.shopify_attributes }}
          >
            <div class="feature-comparison__feature-content flex align-center border-bottom py-sp-3 px-sp-3 h-full fs-big-2 fw-500 word-break">
              {{ block_st.feature_name | escape }}
            </div>
          </div>
          <div
            class="feature-comparison__brand{% if forloop.last %} last-row{% endif %}"
            role="cell"
            aria-rowindex="{{ row_index }}"
            aria-colindex="2"
            aria-describedby="FeatureComparisonBrand-{{ section.id }}"
          >
            <div class="feature-comparison__brand-content flex content-center border-bottom py-sp-3 px-sp-3 text-center h-full fs-small word-break">
              {% if block_st.comparison_type == 'icon' %}
                <svg aria-hidden="true" focusable="false" width="24" height="24" viewBox="0 0 24 24" fill="none">
                  <use href="#icon-feature-yes"></use>
                </svg>
                <span class="visually-hidden">
                  {{ 'sections.feature-comparison.table.included' | t }}
                </span>
              {% else %}
                {{ block_st.brand_content | escape }}
              {% endif %}
            </div>
          </div>
          <div
            class="feature-comparison__competitor{% if forloop.last %} last-row{% endif %}"
            role="cell"
            aria-rowindex="{{ row_index }}"
            aria-colindex="3"
            aria-describedby="FeatureComparisonCompetitor-{{ section.id }}"
          >
            <div class="feature-comparison__competitor-content flex content-center border-bottom py-sp-3 px-sp-3 text-center h-full fs-small word-break">
              {% if block_st.comparison_type == 'icon' %}
                <svg aria-hidden="true" focusable="false" width="22" height="22" viewBox="0 0 22 22" fill="none">
                  <use href="#icon-feature-no"></use>
                </svg>
                <span class="visually-hidden">
                  {{ 'sections.feature-comparison.table.not_included' | t }}
                </span>
              {% else %}
                {{ block_st.competitor_content | escape }}
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.feature-comparison.name",
  "tag": "section",
  "class": "section section-feature-comparison",
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  },
  "max_blocks": 10,
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.general"
    },
    {
      "type": "select",
      "id": "section_width",
      "options": [
        {
          "value": "fix_width",
          "label": "t:sections.all.layout.fix_width"
        },
        {
          "value": "stretch_width",
          "label": "t:sections.all.layout.stretch_width"
        },
        {
          "value": "full_width",
          "label": "t:sections.all.layout.full_width"
        }
      ],
      "default": "fix_width",
      "label": "t:sections.all.layout.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "info": "t:sections.all.colors.info",
      "default": "default-color-scheme"
    },
    {
      "type": "header",
      "content": "t:sections.all.content_header.label"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "t:sections.all.content_setting.subheading.label",
      "default": "<p>Subheading</p>"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.all.content_setting.heading.label",
      "default": "Heading"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:sections.all.content_setting.description.label",
      "default": "<p>Description</p>"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "small",
          "label": "t:sections.all.content_header.heading_size.options__3.label"
        },
        {
          "value": "medium",
          "label": "t:sections.all.content_header.heading_size.options__2.label"
        },
        {
          "value": "large",
          "label": "t:sections.all.content_header.heading_size.options__1.label"
        }
      ],
      "default": "medium",
      "label": "t:sections.all.content_header.heading_size.label"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "default": true,
      "label": "t:sections.review.settings.rating_type.show"
    },
    {
      "type": "range",
      "id": "rating_star",
      "min": 1,
      "max": 5,
      "step": 0.5,
      "label": "t:sections.feedback-product.blocks.settings.rating_star",
      "default": 5,
      "visible_if": "{{ section.settings.show_rating == true }}"
    },
    {
      "type": "color",
      "id": "rate_color",
      "label": "t:sections.review.settings.rate_color.label",
      "default": "#FFB005",
      "visible_if": "{{ section.settings.show_rating == true }}"
    },
    {
      "type": "text",
      "id": "review_text",
      "label": "t:sections.feature-comparison.settings.review_text",
      "default": "Review text",
      "visible_if": "{{ section.settings.show_rating == true }}"
    },
    {
      "type": "select",
      "id": "content_vertical_alignment",
      "options": [
        {
          "value": "start",
          "label": "t:sections.image-with-text.settings.desktop_vertical_alignment.top"
        },
        {
          "value": "center",
          "label": "t:sections.image-with-text.settings.desktop_vertical_alignment.middle"
        },
        {
          "value": "end",
          "label": "t:sections.image-with-text.settings.desktop_vertical_alignment.bottom"
        }
      ],
      "default": "center",
      "label": "t:sections.image-with-text.settings.vertical_alignment"
    },
    {
      "type": "select",
      "id": "header_alignment",
      "options": [
        {
          "value": "start",
          "label": "t:sections.all.text_alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.all.text_alignment.options__2.label"
        },
        {
          "value": "end",
          "label": "t:sections.all.text_alignment.options__3.label"
        }
      ],
      "default": "center",
      "label": "t:sections.all.text_alignment.label"
    },
    {
      "type": "range",
      "id": "padding_content_inline",
      "min": 30,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "t:sections.all.padding.padding_inline.label",
      "info": "t:sections.all.padding.padding_inline.info",
      "default": 100
    },

    {
      "type": "header",
      "content": "t:sections.feature-comparison.settings.comparison_table"
    },
    {
      "type": "select",
      "id": "desktop_table_position",
      "options": [
        {
          "value": "left",
          "label": "t:sections.feature-comparison.settings.desktop_table_position.left"
        },
        {
          "value": "right",
          "label": "t:sections.feature-comparison.settings.desktop_table_position.right"
        }
      ],
      "default": "right",
      "label": "t:sections.feature-comparison.settings.desktop_table_position.label",
      "info": "t:sections.feature-comparison.settings.desktop_table_position.info"
    },
    {
      "type": "range",
      "id": "desktop_table_width",
      "min": 40,
      "max": 60,
      "step": 1,
      "unit": "%",
      "default": 50,
      "label": "t:sections.feature-comparison.settings.desktop_table_width.label",
      "info": "t:sections.feature-comparison.settings.desktop_table_width.info"
    },
    {
      "type": "text",
      "id": "brand_label",
      "label": "t:sections.feature-comparison.settings.brand_label",
      "default": "Brand label"
    },
    {
      "type": "text",
      "id": "competitor_label",
      "label": "t:sections.feature-comparison.settings.competitor_label",
      "default": "Competitor label"
    },
    {
      "type": "checkbox",
      "id": "highlight_brand_column",
      "default": true,
      "label": "t:sections.feature-comparison.settings.highlight_brand_column"
    },

    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "comparison_row",
      "name": "t:sections.feature-comparison.block.comparison_row.label",
      "settings": [
        {
          "type": "text",
          "id": "feature_name",
          "label": "t:sections.feature-comparison.block.comparison_row.feature",
          "default": "Feature"
        },
        {
          "type": "select",
          "id": "comparison_type",
          "options": [
            {
              "value": "icon",
              "label": "t:sections.feature-comparison.block.comparison_row.comparison_type.icon"
            },
            {
              "value": "text",
              "label": "t:sections.feature-comparison.block.comparison_row.comparison_type.text"
            }
          ],
          "default": "icon",
          "label": "t:sections.feature-comparison.block.comparison_row.comparison_type.label"
        },
        {
          "type": "text",
          "id": "brand_content",
          "label": "t:sections.feature-comparison.block.comparison_row.brand_content",
          "default": "Brand content",
          "visible_if": "{{ block.settings.comparison_type == 'text' }}"
        },
        {
          "type": "text",
          "id": "competitor_content",
          "label": "t:sections.feature-comparison.block.comparison_row.competitor_content",
          "default": "Competitor content",
          "visible_if": "{{ block.settings.comparison_type == 'text' }}"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.feature-comparison.name",
      "category": "t:sections.group.storytelling",
      "blocks": [
        {
          "type": "comparison_row"
        },
        {
          "type": "comparison_row"
        },
        {
          "type": "comparison_row"
        },
        {
          "type": "comparison_row"
        },
        {
          "type": "comparison_row"
        }
      ]
    }
  ]
}
{% endschema %}
