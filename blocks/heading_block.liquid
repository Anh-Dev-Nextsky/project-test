{% liquid
  assign theme_st = settings
  assign block_st = block.settings
  assign scroll_animation = theme_st.scroll_animation
  assign type_preset = block_st.type_preset
  assign heading_tag = block_st.heading_tag
  assign width_block = block_st.width_block
  assign width_block_mobile = block_st.width_block_mobile
  assign text_align_mobile = block_st.text_align_mobile
  assign text_align_desktop = block_st.text_align_desktop
  assign text_align = ''
  if width_block != 'fit'
    assign text_align = text_align | append: ' text-1025-' | append: text_align_desktop
  endif
  if width_block_mobile != 'fit'
    assign text_align = text_align | append: ' text-' | append: text_align_mobile
  endif
  assign scroll_animation = 'disable'
%}

{% capture style %}
--space-bottom: {{ block_st.padding_bottom }};--space-top: {{ block_st.padding_top }};--space-left: 0;--space-right: 0;--space-min-left: 0;--space-min-right: 0;
{%- if block_st.padding_top > 20 -%}--space-min-top: {{ block_st.padding_top | times: 0.67 }};{%- else -%}--space-min-top: {{ block_st.padding_top }};{%- endif -%}
{%- if block_st.padding_bottom > 20 -%}--space-min-bottom: {{ block_st.padding_bottom | times: 0.67 }};{%- else -%}--space-min-bottom: {{ block_st.padding_bottom }};{%- endif -%}
{% endcapture %}

{% if request.visual_preview_mode %}
  <div
    class="block__heading inline-block pb-sp-2 rounded-5"
    {{ block.shopify_attributes }}
  >
    <div class="h4">{{ block.settings.heading }}</div>
  </div>
{% else %}
  <div
    class="flexible-block block__heading group-block--height group-block--width-{{ block_st.width_block }} group-block--width-mb-{{ block_st.width_block_mobile }} size-style {{ text_align }} spacing-style switch-slide__mobile"
    style="{{ style | strip | strip_newlines }};{% render 'size-style', settings: block_st, is_group: true %}"
    {{ block.shopify_attributes }}
  >
    {%- if scroll_animation != 'disable' -%}
      <motion-effect
        data-animate="fade-up"
        class="block"
      >
    {%- endif -%}
    <{{ heading_tag }} class="{{ type_preset }} ">
      {{- block.settings.heading -}}
    </{{ heading_tag }}>
    {%- if scroll_animation != 'disable' -%}
      </motion-effect>
    {%- endif -%}
  </div>
{%- endif -%}
{% schema %}
{
  "name": "t:sections.all.content_setting.heading.label",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.custom_section.blocks.heading.how_to_use"
