{% liquid
  assign block_st = block.settings
  assign inherit_color_scheme = block_st.inherit_color_scheme
  assign popup_type = block_st.popup_type
  assign popup_width = block_st.popup_width
  assign button_type = block_st.button_type
  assign text_size = block_st.text_size
  assign icon_type = block_st.icon_type
  assign icon_image = block_st.icon_image
  assign icon_image_alt = icon_image.alt
  assign icon_size = block_st.icon_size
  assign icon_gap = block_st.icon_gap
  assign border_radius_type = block_st.border_radius_type
  if border_radius_type == 'inherit'
    assign border_radius_custom = settings.rounded_image
  elsif border_radius_type == 'none'
    assign border_radius_custom = 0
  else
    assign border_radius_custom = block_st.border_radius_custom
  endif

  assign btn_link_class = ''
  if button_type == 'link'
    assign btn_link_class = 'btn-link'
  elsif button_type == 'primary'
    assign btn_link_class = 'btn btn-primary'
  elsif button_type == 'outline'
    assign btn_link_class = 'btn btn-outline'
  endif
  assign class_popup_type = ''
  assign draggable_modal = false
  if popup_type == 'drawer'
    assign class_popup_type = 'modal-inner hidden-drag draw-mb drawer-right-mb drawer drawer-right fixed right-0 inset-y-0 z-2'
    assign draggable_modal = false
  else
    assign class_popup_type = 'modal-popup-inner rounded max-w-custom m-auto modal-draggable invisible'
    assign draggable_modal = true
  endif
%}

{%- capture style -%}
  --space-bottom: {{ block_st.padding_bottom }};--space-top: {{ block_st.padding_top }};--space-left: 0;--space-right: 0;--space-min-left: 0;--space-min-right: 0;
{%- if block_st.padding_top > 20 -%}--space-min-top: {{ block_st.padding_top | times: 0.67 }};{%- else -%}--space-min-top: {{ block_st.padding_top }};{%- endif -%}
{%- if block_st.padding_bottom > 20 -%}--space-min-bottom: {{ block_st.padding_bottom | times: 0.67 }};{%- else -%}--space-min-bottom: {{ block_st.padding_bottom }};{%- endif -%}
  --gap: {{ icon_gap }}px;
  --img-rounded: {{ border_radius_custom }}px;--drawer-rounded: {{ border_radius_custom }}px;
{%- endcapture -%}
<div
  class="flexible-block popup-links size-style group-block--height group-block--width-{{ block_st.width_block }} group-block--width-mb-{{ block_st.width_block_mobile }}{% if block_st.inherit_color_scheme_link == false %} color-{{ block_st.color_scheme_link }}{% endif %} switch-slide__mobile{% if request.visual_preview_mode %} bg-white p-sp-5 rounded-5{% else %} spacing-style{% endif %}"
  style="{{ style | strip | strip_newlines }};{% render 'size-style', settings: block_st, is_group: true %}"
  {{ block.shopify_attributes }}
>
  <popup-link
    data-section-id="{{ section.id }}"
    class="popup-link flex content-center gap border-animation pointer {{ btn_link_class }} {{ text_size }}{% if request.visual_preview_mode %} active{% endif %}"
    data-drag="{{ draggable_modal }}"
    tabindex="0"
  >
    <span>
      {{ block.settings.text }}
    </span>

    {% if icon_type == 'arrow' %}
      <svg width="{{ icon_size }}" height="{{ icon_size }}" viewBox="0 0 512 512" class="rtl-mirror">
        <use href="#icon-arrow-right"></use>
      </svg>
    {% elsif icon_type == 'image' %}
      <div class="h-custom w-custom flex" style="--width: {{ icon_size }}px;">
        {% if icon_image != blank %}
          {% render 'responsive-image',
            type: 'product',
            image: icon_image,
            image_alt: icon_image_alt,
            class_motion: ' h-full w-full'
          %}
        {% else %}
          {%- render 'placeholder-render',
            type: 'lifestyle-2',
            class: 'img-placeholder h-full w-full',
            class_motion: ' h-full'
          -%}
        {% endif %}
      </div>
    {% endif %}
      <template>
    <link-popup
      data-section-id="{{ section.id }}"
      drawe
      class="modal modal_type_popup active-modal-js modal-newsletter-popup fixed inset-0 z-31 flex align-center invisible transition content-hidden"
    >
      <modal-overlay class="modal-overlay invisible transition-drawer cursor-crosshair"></modal-overlay>
      <div
        class="{{ class_popup_type }} modal-focus modal-body transition bg-white z-15 overflow-auto custom-scrollbar{% if inherit_color_scheme == false %} color-{{ block_st.color_scheme }}{% endif %}"
        style="{% if popup_type == 'drawer' %}--drawer-width: {{ popup_width }}px;{% else %}--max-width: {{ popup_width }}px;{% endif %}"
        tabindex="-1"
      >
        <button
          is="button-close-model"
          class="modal__close modal-button-close rounded-50 pointer btn-reset wh-58 flex-1025 content-center absolute z-3 top-sp-3 right-sp-3"
          aria-label="Close"
        >
          <svg
            width="12"
            height="12"
            viewBox="0 0 14 14"
            fill="none"
            class="transition-short will-change icon-zoom"
          >
            <use href="#icon-close"></use>
          </svg>
        </button>
        <div class="drawer__body drawer__body-item h-full overflow-y-auto custom-scrollbar drawer-spacing">
          {% content_for 'blocks' %}
        </div>
      </div>
    </link-popup>
  </template>
  </popup-link>
</div>
<script type="module" src="{{ 'block-popup-link.js' | asset_url }}" defer="defer"></script>
{% schema %}
{
  "name": "t:sections.group.links.popup_link",
  "tag": null,
  "settings": [
