{% liquid
  assign section_st = section.settings
  assign block_st = block.settings
%}
{% capture style %}
--space-bottom: {{ block.settings.padding_bottom }};--space-top: {{ block.settings.padding_top }};--rate-color: {{ section_st.rate_color }};
{% endcapture %}
<div
  class="block__author mb-custom mt-custom{% if block_st.padding_bottom > 10 %} mb_auto-rsp{% endif %}{% if block_st.padding_top > 10 %} mt_auto-rsp{% endif %}"
  style="{{ style | strip | strip_newlines }}"
  {{ block.shopify_attributes }}
>
  {% liquid
    assign block_st = block.settings
    assign rating_star = block_st.rating_star
    assign rating_integer = rating_star | floor
    assign rating_decimal = rating_star | modulo: 1
  %}
  <div class="inline-flex flex-md-row gap-sp-4">
    {% if section_st.show_author_image %}
      <div class="hover-effect block-md shrink-0 align-self-center">
        <div
          class="author-image w-custom rounded-custom overflow-hidden"
          style="--aspect-ratio: 1/1; --width: {{ block_st.image_width }}px; --radius: {{ block_st.border_radius }}%;"
        >
          {% if block_st.author_image != blank %}
            {% render 'responsive-image',
              image: block_st.author_image,
              type: 'review',
              column: 1,
              padding: 0,
              animate: 'fade-in'
            -%}
          {%- else %}
            {% render 'placeholder-render' %}
          {% endif %}
        </div>
      </div>
    {% endif %}

    <div class="flex column align-start justify-center">
      {% if section_st.show_rating != false %}
        <div
          class="rating flex mb-sp-2 mb-1025-sp-2 relative me-3"
          role="img"
        >
          <span
            aria-hidden="true"
            class="star-rating inline-flex align-center gap"
            style="--gap: 1px; --gap-desktop: 1px;"
          >
            {%- for i in (1..5) -%}
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                <use href="#icon-rate"></use>
              </svg>
            {%- endfor -%}
          </span>
          <div
            class="absolute inset-0 z-1 inline-flex align-center gap"
            style="--gap: 1px; --gap-desktop: 1px;"
          >
            {%- for i in (1..rating_integer) -%}
              <svg
                width="12"
                height="12"
                viewBox="0 0 12 12"
                fill="none"
                class="rate-color"
              >
                <use href="#icon-rate"></use>
              </svg>
            {%- endfor -%}
            {% if rating_decimal == 0.5 %}
              <svg
                width="12"
                height="12"
                viewBox="0 0 12 12"
                fill="none"
                class="half-star rtl-mirror"
              >
                <use href="#icon-rate-half"></use>
              </svg>
            {% endif %}
          </div>
        </div>
      {% endif %}

      <div class="flex wrap gap-10 align-center">
        <span class="word-break author-name">
          {{ block_st.author_name }}
        </span>

        {% if section_st.show_verified_buyer -%}
          <span class="dark-grey flex gap-5 align-center fs-small">
            <svg width="14" height="10" viewBox="0 0 16 12" fill="none">
              <use href="#icon-tick"></use>
            </svg>
            <i>{{- 'review.verified_buyer.default' | t -}}</i>
          </span>
        {%- endif %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.all.content_setting.author.label",
  "class": "w-full",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.review.blocks.content"
    },
    {
      "type": "image_picker",
      "id": "author_image",
      "label": "t:sections.review.blocks.settings.author_image"
    },
    {
      "type": "range",
      "id": "image_width",
      "label": "t:sections.all.image.width",
      "default": 100,
      "min": 50,
      "max": 150,
      "step": 5,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "%",
      "label": "t:sections.custom_section.settings.appearance.settings.corner_radius.label",
      "default": 50
    },
    {
      "type": "text",
      "id": "author_name",
      "label": "t:sections.review.blocks.settings.author_name",
      "default": "Author Name"
    },
    {
      "type": "range",
      "id": "rating_star",
      "min": 1,
      "max": 5,
      "step": 0.5,
      "label": "t:sections.review.blocks.settings.rating_star",
      "default": 5
    },

    {
      "type": "header",
      "content": "t:sections.custom_section.blocks.page.spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 10
    }
  ],
  "presets": [{ "name": "t:sections.all.content_setting.author.label" }]
}
{% endschema %}
