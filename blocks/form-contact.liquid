{% liquid
  assign contact_id = 'ContactForm-' | append: block.id
  assign block_st = block.settings
%}
{% capture style %}
--space-bottom: {{ block_st.padding_bottom }};--space-top: {{ block_st.padding_top }};--space-left: 0;--space-right: 0;--space-min-left: 0;--space-min-right: 0;--input-color: #444;
{%- if block_st.padding_top > 20 -%}--space-min-top: {{ block_st.padding_top | times: 0.67 }};{%- else -%}--space-min-top: {{ block_st.padding_top }};{%- endif -%}
{%- if block_st.padding_bottom > 20 -%}--space-min-bottom: {{ block_st.padding_bottom | times: 0.67 }};{%- else -%}--space-min-bottom: {{ block_st.padding_bottom }};{%- endif -%}
{% endcapture %}

{%- form 'contact',
  id: contact_id,
  class: 'form-validation isolate field w-full-mb switch-slide__mobile group-block--height'
-%}
  {%- if form.posted_successfully? -%}
    <div
      class="form-status form-status form__message success mb-10 flex align-center gap-10 mb-10"
      tabindex="-1"
      autofocus
    >
      <div class="flex content-center">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" class="flex-auto w-18">
          <use href="#icon-success"></use>
        </svg>
      </div>
      {{ 'templates.contact.form.post_success' | t }}
    </div>
  {%- elsif form.errors -%}
    <div class="form__message error mb-10">
      <div
        class="flex align-center gap-10"
        role="alert"
        tabindex="-1"
        autofocus
      >
        <div class="flex content-center">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" class="flex-auto w-18">
            <use href="#icon-error"></use>
          </svg>
        </div>
        {{ 'templates.contact.form.error_heading' | t }}
      </div>
      <ul class="list-unstyled w-custom fs-small" style="--width: calc(100% - 24px)">
        <li>
          <a
            href="#ContactForm-email"
            class="color-inherit"
            aria-label=" {{ form.errors.translated_fields.email }}"
          >
            {{ form.errors.translated_fields.email | capitalize }}
            {{ form.errors.messages.email }}
          </a>
        </li>
      </ul>
    </div>
  {%- endif -%}
  <div
    class="flexible-block group-block--height-{{ block_st.height_block }} group-block--width-{{ block_st.width_block }} group-block--width-mb-{{ block_st.width_block_mobile }} size-style spacing-style m-auto{% if request.visual_preview_mode %} bg-white p-sp-5 rounded-5{% endif %}"
    style="{{ style | strip | strip_newlines }};{% render 'size-style', settings: block_st, is_group: true %}"
    {{ block.shopify_attributes }}
  >
    <div
      class="contact__fields field grid-cols m-custom"
      style="--m-custom: 1px;"
    >
      <div class="flex column flex-md-row gap-sp-5 gap-1025-sp-6 mb-sp-5 mb-1025-sp-6">
        <div
          class="field relative w-full flex wrap"
        >
          <input
            class="field__input w-full"
            autocomplete="name"
            type="text"
            id="ContactFormName-{{ block.id }}"
            name="contact[name]"
            required
            minlength="2"
            value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
            placeholder="{{ block.settings.name }} *"
          >
          <label class="field__label" for="ContactFormName-{{ block.id }}"> {{ block.settings.name }} * </label>
        </div>
        <div class="field relative w-full flex wrap field--with-error">
          <input
            autocomplete="email"
            type="email"
            id="ContactFormEmail-{{ block.id }}"
            class="field__input w-full"
            name="contact[email]"
            spellcheck="false"
            autocapitalize="off"
            autocorrect="off"
            value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
            aria-required="true"
            {% if form.errors contains 'email' %}
              aria-invalid="true"
              aria-describedby="ContactForm-email-error"
            {% endif %}
            placeholder="{{ block.settings.email }} *"
            required
            pattern=".+\.[a-zA-Z]{2,6}"
          >
          <label class="field__label" for="ContactFormEmail-{{ block.id }}"> {{ block.settings.email }} *</label>
          {%- if form.errors contains 'email' -%}
            <div class="contact__field-error error flex align-center mt-10" id="ContactForm-email-error">
              <span class="visually-hidden">{{ 'accessibility.error' | t }}</span>
              <div class="flex content-center">
                <svg width="18" height="18" viewBox="0 0 18 18" fill="none" class="flex-auto w-18">
                  <use href="#icon-error"></use>
                </svg>
              </div>
              <span class="form__message">
                {{- form.errors.translated_fields.email | capitalize }}
                {{ form.errors.messages.email -}}
              </span>
            </div>
          {%- endif -%}
        </div>
      </div>
      {% if block.settings.phone != blank %}
        <div class="field mb-sp-5 relative">
          <input
            type="tel"
            id="ContactFormPhone-{{ block.id }}"
            class="field__input w-full"
            autocomplete="tel"
            name="contact[{{ block.settings.phone }}]"
            pattern="[+0-9\-]*"
            value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
            placeholder="{{ block.settings.phone }} *"
            required
          >
          <label class="field__label" for="ContactFormPhone-{{ block.id }}"> {{ block.settings.phone }} *</label>
        </div>
      {% endif %}
      {% if block.settings.select_label != blank %}
        {% liquid
          assign option_select = block.settings.option_select
          assign select_options = option_select | split: ','
        %}
        <div class="field relative w-full flex wrap mb-sp-5 mb-1025-sp-6 field-contact-subject">
          <select
            id="ContactFormSubject-{{ block.id }}"
            class="field__input w-full contact-form-subject"
            name="contact[{{ block.settings.select_label }}]"
            required
          >
            <option value="" disabled selected>{{ block.settings.select_label }} *</option>
            {% if option_select != blank %}
              {% for option in select_options %}
                <option value="{{ option | strip }}">{{ option | strip }}</option>
              {% endfor %}
            {% endif %}
          </select>
          <label for="ContactFormSubject-{{ block.id }}" class="field__label">
            {{ block.settings.select_label }} *
          </label>
        </div>
      {% endif %}
      <div
        class="field relative w-full flex wrap"
      >
        <textarea
          rows="3"
          id="ContactFormMessage-{{ block.id }}"
          class="text-area field__input w-full"
          aria-required="true"
          aria-invalid="true"
          name="contact[body]"
          placeholder="{{ block.settings.message }} *"
          required
          minlength="2"
          style="--input-padding-start: 2.5rem;--input-padding-end: 2.5rem;--input-padding-top: 2.5rem;--input-padding-bottom: 2.5rem;"
        >
        {{- form.body -}}
        </textarea>
        <label class="form__label field__label" for="ContactFormMessage-{{ block.id }}">
          {{ block.settings.message }} *
        </label>
      </div>
    </div>
    <div
      class="contact__button mt-30 mt-1025-sp-10 flex justify-center"
    >
      {% content_for 'block', type: '_submit-button', id: 'button' %}
    </div>
  </div>
{%- endform -%}

{% schema %}
{
  "name": "t:sections.custom_section.blocks.contact_form.name",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.custom_section.blocks.contact_form.how_to_use"
    },
    {
      "type": "text",
      "id": "name",
      "label": "t:sections.custom_section.blocks.contact_form.settings.name",
      "default": "t:sections.custom_section.blocks.contact_form.settings.name"
    },
    {
      "type": "text",
      "id": "email",
      "label": "t:sections.custom_section.blocks.contact_form.settings.email",
      "default": "t:sections.custom_section.blocks.contact_form.settings.email"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "t:sections.custom_section.blocks.contact_form.settings.phone"
    },
    {
      "type": "text",
      "id": "select_label",
      "label": "t:sections.custom_section.blocks.contact_form.settings.select_label",
      "default": "t:sections.custom_section.blocks.contact_form.settings.default_select_label"
    },
    {
      "type": "text",
      "id": "option_select",
      "label": "t:sections.custom_section.blocks.contact_form.settings.option",
      "default": "t:sections.custom_section.blocks.contact_form.settings.default_option"
    },
    {
      "type": "text",
      "id": "message",
      "label": "t:sections.custom_section.blocks.contact_form.settings.message",
      "default": "t:sections.custom_section.blocks.contact_form.settings.message"
    },
    {
      "type": "header",
      "content": "t:sections.custom_section.blocks.settings.size.label"
    },
    {
      "type": "select",
      "id": "width_block",
      "label": "t:sections.custom_section.blocks.settings.size.width.label",
      "default": "fit",
      "options": [
        {
          "value": "fit",
          "label": "t:sections.custom_section.blocks.settings.size.options.options__1.label"
        },
        {
          "value": "fill",
          "label": "t:sections.custom_section.blocks.settings.size.options.options__2.label"
        },
        {
          "value": "custom",
          "label": "t:sections.custom_section.blocks.settings.size.options.options__3.label"
        }
      ]
    },
    {
      "type": "range",
      "id": "custom_width",
      "min": 5,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "label": "t:sections.custom_section.blocks.settings.size.width.custom_width.label",
      "visible_if": "{{ block.settings.width_block == 'custom' }}"
    },
    {
      "type": "select",
      "id": "width_block_mobile",
      "label": "t:sections.custom_section.blocks.settings.size.mobile_width.label",
      "default": "fill",
      "options": [
        {
          "value": "fit",
          "label": "t:sections.custom_section.blocks.settings.size.options.options__1.label"
        },
        {
          "value": "fill",
          "label": "t:sections.custom_section.blocks.settings.size.options.options__2.label"
        },
        {
          "value": "custom",
          "label": "t:sections.custom_section.blocks.settings.size.options.options__3.label"
        }
      ]
    },
    {
      "type": "range",
      "id": "custom_width_mobile",
      "min": 5,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "label": "t:sections.custom_section.blocks.settings.size.width.custom_width.label",
      "visible_if": "{{ block.settings.width_block_mobile == 'custom' }}"
    },
    {
      "type": "header",
      "content": "t:sections.custom_section.blocks.page.spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:sections.custom_section.blocks.contact_form.name",
      "category": "t:sections.group.blocks.forms",
      "blocks": {
        "button": {
          "type": "_submit-button",
          "static": true
        }
      }
    }
  ]
}
{% endschema %}
