                        <div class="size-form__actions flex gap-sp-3 pt-sp-4 pt-1025-sp-6 px-sp-5 px-1025-sp-8 pb-sp-5 pb-1025-sp-8 border-top bright_gradient relative">
                          <div class="flex-1">
                            <button
                              type="button"
                              class="size-form__btn size-form__btn--next w-full btn btn-outline flex gap-sp-3 content-center max-w-custom min-w-custom"
