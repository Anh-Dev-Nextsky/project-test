                      </div>

                      <div
                        id="size-tabpanel-hips-shapes-{{ block.id }}"
                        class="size-tab__content inset-0 absolute invisible transition tab-shapes flex flex-1 column h-full"
                        data-tab-content="hips_shapes"
                        role="tabpanel"
                        aria-labelledby="size-tab-hips-shapes-{{ block.id }}"
                        aria-hidden="true"
                        tabindex="-1"
                        hidden
                      >
                        <div class="pt-sp-6 pb-sp-8 overflow-y-auto custom-scrollbar grow-1">
                          <div
                            class="size-form__group size-form__group-has-images flex column h-full flex-center"
                            style="--checkmark_width: 4.2rem;--check_width: 8px;--check_height: 14px;--min-width: 7rem;--min-width-1025: 8rem;"
                          >
                            <div
                              class="images_fit_preference relative flex gap-sp-2 mb-sp-4 mb-1025-sp-6 flex-center h-custom pointer-none w-full"
                              style="--height: 18rem;"
                            >
                              <div class="image_fit_preference relative image_fit_preference--straights absolute transition pointer flex opacity-0">
                                <img
                                  src="{{ 'hip-shape-1.png' | asset_url }}"
                                  alt="{{ 'products.product.size_recommendation_popup.shapes.fitted' | t }}"
                                  width="150"
                                  height="150"
                                  class="block h-custom w-fit"
                                  style="--height: 18rem;"
                                >
                              </div>
                              <div class="image_fit_preference transition pointer absolute flex image_fit_preference--average opacity-0">
                                <img
                                  src="{{ 'hip-shape-2.png' | asset_url }}"
                                  alt="{{ 'products.product.size_recommendation_popup.shapes.regular' | t }}"
                                  width="150"
                                  height="150"
                                  class="block h-custom w-fit"
                                  style="--height: 18rem;"
                                >
                              </div>
                              <div class="image_fit_preference transition pointer absolute flex image_fit_preference--wider opacity-0">
                                <img
                                  src="{{ 'hip-shape-3.png' | asset_url }}"
                                  alt="{{ 'products.product.size_recommendation_popup.shapes.oversized' | t }}"
                                  width="150"
                                  height="150"
                                  class="block h-custom w-fit"
                                  style="--height: 18rem;"
                                >
                              </div>
                            </div>
                            <div id="size-fit-preference-label-{{ block.id }}" class="visually-hidden">
                              {{ 'products.product.size_recommendation_popup.tabs.hips_shapes' | t }}
                            </div>
                            <div
                              class="size-form__checkboxes flex wrap gap-sp-6 flex-center"
                              role="radiogroup"
                              aria-labelledby="size-fit-preference-label-{{ block.id }}"
                            >
                              <div
                                class="size-form__radio-card flex column gap-sp-1 relative align-center pointer min-w-custom min-w-1025-custom"
                                data-size-radio-card
                                role="radio"
                                aria-checked="true"
                                tabindex="0"
                              >
                                <input
                                  type="radio"
                                  name="fit_preference"
                                  value="straights"
                                  checked
                                  class="opacity-0 absolute inset-0 w-full h-full m-0 pointer"
                                  id="fit_preference_fitted"
                                  tabindex="-1"
                                >
                                <span
                                  class="checkmark-custom checkmark relative pointer-none hidden inline-flex w-custom h-custom"
                                  style="--width: 4.2rem; --height: 4.2rem;"
                                ></span>
                                <label class="text-center" for="fit_preference_fitted">
                                  <span>
                                    {{- 'products.product.size_recommendation_popup.shapes.fitted' | t -}}
                                  </span>
                                </label>
                              </div>
                              <div
                                class="size-form__radio-card flex column gap-sp-1 relative align-center pointer min-w-custom min-w-1025-custom"
                                data-size-radio-card
                                role="radio"
                                aria-checked="false"
                                tabindex="0"
                              >
                                <input
                                  type="radio"
                                  name="fit_preference"
                                  value="average"
                                  class="opacity-0 absolute inset-0 w-full h-full m-0 pointer"
                                  id="fit_preference_regular"
                                  tabindex="-1"
                                >
                                <span
                                  class="checkmark-custom checkmark relative pointer-none hidden inline-flex w-custom h-custom"
                                  style="--width: 4.2rem; --height: 4.2rem;"
                                ></span>
                                <label
                                  for="fit_preference_regular"
                                  class="size-form__checkboxes flex wrap gap-sp-2 flex-center"
                                >
                                  <span>
                                    {{- 'products.product.size_recommendation_popup.shapes.regular' | t -}}
                                  </span>
                                </label>
                              </div>
                              <div
                                class="size-form__radio-card flex column gap-sp-1 relative align-center pointer min-w-custom min-w-1025-custom"
                                data-size-radio-card
                                role="radio"
                                aria-checked="false"
                                tabindex="0"
                              >
                                <input
                                  type="radio"
                                  name="fit_preference"
                                  value="wider"
                                  class="opacity-0 absolute inset-0 w-full h-full m-0 pointer"
                                  id="fit_preference_oversized"
                                  tabindex="-1"
                                >
                                <span
                                  class="checkmark-custom checkmark relative pointer-none hidden inline-flex w-custom h-custom"
                                  style="--width: 4.2rem; --height: 4.2rem;"
                                ></span>
                                <label
                                  for="fit_preference_oversized"
                                  class="size-form__checkboxes flex wrap gap-sp-2 flex-center "
                                >
                                  <span>
                                    {{- 'products.product.size_recommendation_popup.shapes.oversized' | t -}}
                                  </span>
                                </label>
                              </div>
                            </div>
                          </div>
                        </div>
                        <div class="size-form__actions flex gap-sp-3 pt-sp-4 pt-1025-sp-6 px-sp-5 px-1025-sp-8 pb-sp-5 pb-1025-sp-8 border-top border-top bright_gradient relative">
                          <div class="flex-1">
                            <button
                              type="button"
                              class="size-form__btn size-form__btn--next w-full btn btn-outline flex gap-sp-3 content-center max-w-custom min-w-custom"
                              style="--max-width: 15rem;--min-width: 13rem;"
                              data-next-tab="tummy_shapes"
                            >
                              {{ 'products.product.size_recommendation_popup.basics.back' | t }}
                            </button>
                          </div>
                          {%- liquid
                            assign recommend_size_metaobject_shapes = product.metafields.custom.size_recommend_sizing_system.value
                          -%}
                          {% if recommend_size_metaobject_shapes != blank %}
                            <button
                              type="button"
                              class="size-form__btn size-form__btn--next w-full btn btn-primary flex gap-sp-3 content-center"
                              data-next-tab="measurements"
                            >
                              {{ 'products.product.size_recommendation_popup.shapes.next' | t }}
                            </button>
                          {% else %}
                            <button
                              type="button"
                              class="size-form__btn size-form__btn--submit w-full btn btn-primary flex gap-sp-3 content-center"
                              data-submit-size
                              data-section-id="{{ section.id }}"
                            >
                              {{ 'products.product.size_recommendation_popup.shapes.next' | t }}
                            </button>
                          {% endif %}
                        </div>
                      </div>

                      {%- liquid
                        assign recommend_size_metaobject = product.metafields.custom.size_recommend_sizing_system.value
                        assign entries_count = recommend_size_metaobject.size | default: 0
                      -%}
                      {% if recommend_size_metaobject != blank %}
                        <div
                          id="size-tabpanel-measurements-{{ block.id }}"
                          class="size-tab__content inset-0 absolute invisible transition tab-shapes flex flex-1 column h-full"
                          data-tab-content="measurements"
                          role="tabpanel"
                          aria-labelledby="size-tab-measurements-{{ block.id }}"
                          aria-hidden="true"
                          tabindex="-1"
                          hidden
                        >
                          <div
                            class="flex-1 flex gap-sp-3 column overflow-y-auto custom-scrollbar px-sp-5 px-1025-sp-8 py-sp-4 py-1025-sp-6"
                          >
                            {% if entries_count > 1 %}
                              <div class="size-form__group flex column w-full">
                                <label for="size-system-sizing" class="heading-style mb-sp-1">
                                  {{- 'products.product.size_recommendation_popup.measurements.sizing_system' | t -}}
                                </label>
                                <select
                                  id="size-system-sizing"
                                  name="system_sizing"
                                  class="size-form__select w-full select show-placehoder"
                                  data-system-sizing
                                >
                                  {% for entry in recommend_size_metaobject %}
                                    <option
                                      value="{{ forloop.index0 }}"
                                      data-system="{{ entry.sizing_system }}"
                                      {% if forloop.first %}
                                        selected
                                      {% endif %}
                                    >
                                      {{ entry.sizing_system }}
                                    </option>
                                  {% endfor %}
                                </select>
                              </div>
                            {% endif %}

                            <div class="size-form__group" data-bust-group>
                              <div class="heading-style size-form__label mb-sp-1">
                                {{- 'products.product.size_recommendation_popup.measurements.bust_size' | t -}}
                              </div>
                              {% for entry in recommend_size_metaobject %}
                                <div
                                  class="size-form__checkboxes wrap gap-sp-1{% unless forloop.first %} hidden{% else %} flex{% endunless %}"
                                  data-bust-options="{{ forloop.index0 }}"
                                >
                                  {% assign bust_values = entry.bust_size | split: ',' %}
                                  {% for bust in bust_values %}
                                    {% assign bust_trimmed = bust | strip %}
                                    {% if bust_trimmed != blank %}
                                      <label
                                        class="size-form__radio-card size-form__checkbox-label btn-rounded py-6 flex content-center border pointer transition bg-white heading-color relative min-w-custom min-w-1025-custom"
                                        style="--min-width: 6rem;--min-width-1025: 8rem;"
                                        data-size-radio-card
                                        role="radio"
                                        aria-checked="false"
                                        tabindex="0"
                                      >
                                        <input
                                          type="radio"
                                          class="overflow-hidden absolute h-custom w-custom"
                                          style="--height: 1px;--width: 1px;"
                                          name="bust_size_{{ forloop.parentloop.index0 }}"
                                          value="{{ bust_trimmed }}"
                                          tabindex="-1"
                                        >
                                        <span>{{ bust_trimmed }}</span>
                                      </label>
                                    {% endif %}
                                  {% endfor %}
                                </div>
                              {% endfor %}
                            </div>

                            {%- comment -%} Cup Size Options {%- endcomment -%}
                            <div class="size-form__group" data-cup-group>
                              <div class="heading-style size-form__label mb-sp-1">
                                {{- 'products.product.size_recommendation_popup.measurements.cup_size' | t -}}
                              </div>
                              {% for entry in recommend_size_metaobject %}
                                <div
                                  class="size-form__checkboxes wrap gap-sp-1{% unless forloop.first %} hidden {% else %} flex{% endunless %}"
                                  data-cup-options="{{ forloop.index0 }}"
                                >
                                  {% assign cup_values = entry.cup | split: ',' %}
                                  {% for cup in cup_values %}
                                    {% assign cup_trimmed = cup | strip %}
                                    {% if cup_trimmed != blank %}
                                      <label
                                        class="size-form__radio-card size-form__checkbox-label btn-rounded py-6 flex content-center border pointer transition bg-white heading-color relative min-w-custom min-w-1025-custom"
                                        style="--min-width: 6rem;--min-width-1025: 8rem;"
                                        data-size-radio-card
                                        role="radio"
                                        aria-checked="false"
                                        tabindex="0"
                                      >
                                        <input
                                          type="radio"
                                          class="overflow-hidden absolute h-custom w-custom"
                                          style="--height: 1px;--width: 1px;"
                                          name="cup_size_{{ forloop.parentloop.index0 }}"
                                          value="{{ cup_trimmed }}"
                                          tabindex="-1"
                                        >
                                        <span>{{ cup_trimmed }}</span>
                                      </label>
                                    {% endif %}
                                  {% endfor %}
                                </div>
                              {% endfor %}
                            </div>
                          </div>
                          <div class="size-form__actions flex gap-sp-3 pt-sp-4 pt-1025-sp-6 px-sp-5 px-1025-sp-8 pb-sp-5 pb-1025-sp-8 border-top bright_gradient relative">
                            <div class="flex-1">
                              <button
                                type="button"
                                class="size-form__btn size-form__btn--next w-full btn btn-outline flex gap-sp-3 content-center max-w-custom min-w-custom"
                                style="--max-width: 15rem;--min-width: 13rem;"
                                data-next-tab="hips_shapes"
                              >
                                {{ 'products.product.size_recommendation_popup.basics.back' | t }}
                              </button>
                            </div>
                            <button
                              type="button"
                              class="size-form__btn size-form__btn--submit w-full btn btn-primary flex gap-sp-3 content-center"
                              data-submit-size
                              data-section-id="{{ section.id }}"
                            >
                              {{ 'products.product.size_recommendation_popup.shapes.next' | t }}
                            </button>
                          </div>
                        </div>
                      {% endif %}
                      <div
                        id="size-tabpanel-result-{{ block.id }}"
                        class="size-tab__content inset-0 absolute invisible transition flex flex-1 column h-full"
                        data-tab-content="result"
                        hidden
                      >
                        <div
                          class="size-recommendation-result flex-1 flex column overflow-y-auto custom-scrollbar px-sp-5 px-1025-sp-8 py-sp-4 py-1025-sp-6"
                        >
                          <div class="recommend-size-available">
                            <div class="recommended-size-label-stock ">
                              <span>
                                {{ 'products.product.size_recommendation_popup.result.label' | t }}
                              </span>
                              <span
                                class="recommended-size-in-stock-status text-color whitespace-nowrap"
                                style="--color-text: #14854E"
                              >
                                {{ 'products.product.size_recommendation_popup.result.label_instock' | t }}
                              </span>
                              <span class="recommended-size-out-stock-status hidden">
                                {{ 'products.product.size_recommendation_popup.result.label_soldout' | t }}
                              </span>
                            </div>
                            <div class="h3 py-sp-4 border-dash-bottom text-transform-none">
                              {{ 'products.product.size_recommendation_popup.result.result' | t -}}
                              <span class="recommended-size-value"></span>
                            </div>
                          </div>
                          <div class="recommend-size-not-available hidden border-dash-bottom">
                            <div class="warning relative flex gap-sp-2">
                              <svg width="18" height="18" fill="none" class="flex-auto w-18">
                                <use href="#icon-warning"></use>
                              </svg>
                              <span>
                                {{- 'products.product.size_recommendation_popup.measurements.not_available_noti' | t -}}
                              </span>
                            </div>
                            <div class="text_not_available prose py-sp-4">
                              {{ block_st.text_not_available }}
                            </div>
                          </div>
                          <div class="recommended-size-note py-sp-4">
                            <div class="flex space-between align-center">
                              <span class="size-recommendation-note heading-style mb-sp-2">
                                {{ 'products.product.size_recommendation_popup.result.note' | t }}
                              </span>
                            </div>
                            <div
                              class="size-recommendation-details flex row gap"
                              style="--gap-desktop: 10rem;--gap: 2.4rem;"
                            >
                              <div class="details-left flex-1 flex column gap-sp-1">
                                <p class="detail-height">
                                  {{ 'products.product.size_recommendation_popup.result.height' | t }}
                                  <span class="detail-value" id="heightValue"></span>&nbsp;<span
                                    class="detail-unit"
                                  ></span>
                                </p>
                                <p class="detail-weight">
                                  {{ 'products.product.size_recommendation_popup.result.weight' | t }}
                                  <span class="detail-value" id="weightValue"></span>&nbsp;<span
                                    class="detail-unit"
                                  ></span>
                                </p>
                                <p class="detail-gender hidden">
                                  {{ 'products.product.size_recommendation_popup.result.gender' | t }}
                                  <span class="detail-value capitalize" id="genderValue"></span>
                                </p>
                                <p class="detail-body-shape">
                                  {{ 'products.product.size_recommendation_popup.result.body_shape' | t }}
                                  <span class="detail-value capitalize" id="bodyShapeValue"></span>
                                </p>
                              </div>
                              <div class="details-right flex-1 flex column gap-sp-1">
                                <p class="detail-fit-preference">
                                  {{ 'products.product.size_recommendation_popup.result.fit_preference' | t }}
                                  <span class="detail-value capitalize" id="fitPreferenceValue"></span>
                                </p>
                                <p class="detail-bust-size">
                                  {{ 'products.product.size_recommendation_popup.result.bust_size' | t }}
                                  <span class="detail-value" id="bustSizeValue"></span>
                                </p>
                                <p class="detail-cup-size">
                                  {{ 'products.product.size_recommendation_popup.result.cup_size' | t }}
                                  <span class="detail-value" id="cupSizeValue"></span>
                                </p>
                              </div>
                            </div>
                          </div>
                          <div class="recommend-size-info_html pt-sp-4 border-dash-top prose">
                            {{ block_st.fit_recommendation_note }}
                          </div>
                        </div>
                        <div class="size-form__actions flex gap-sp-3 pt-sp-4 pt-1025-sp-6 px-sp-5 px-1025-sp-8 pb-sp-6 pb-1025-sp-8 border-top wrap row-gap-sp-2 w-full bright_gradient relative">
                          <div class="w-full w-1025-auto">
                            <button
                              type="button"
                              class="size-form__btn size-form__btn--next w-full btn btn-outline text-center min-w-custom whitespace-nowrap h-full"
                              style="--min-width: 15rem;"
                              data-reset-form
                              data-section-id="{{ section.id }}"
                            >
                              {{ 'products.product.size_recommendation_popup.result.start_over' | t }}
                            </button>
                          </div>
                          <div class="flex-1">
                            <button
                              type="button"
                              class="size-form__btn btn btn-primary w-full relative whitespace-nowrap relative"
                              data-add-to-cart-size
                              disabled
                              aria-disabled="true"
                              tabindex="-1"
                            >
                              <span
                                class="btn-label btn-label-size hidden-on-load transition-short text-center"
                                aria-live="polite"
                                aria-atomic="true"
                              >
                                {{ 'products.product.add_to_cart' | t }}
                                <span class="dot-total mx-sp-1"> - </span>
                                <span class="total-price__size">
                                  {{ 0 | money }}
                                </span></span
                              >
                              {%- render 'loader' -%}
                            </button>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                  <script type="application/json" class="size-recommendation-data">
                    {
                      "product_size": "{{ size_value }}",
                      "product_id": "{{ product.id }}",
                      "product_handle": "{{ product.handle }}"
                    }
                  </script>
                  <script type="application/json" class="size-chart-data">
                    {{ recommend_size_metaobject | json }}
                  </script>
                  <script type="application/json" class="product-variants-data">
                    {{ product.selected_or_first_available_variant | json }}
                  </script>
                </size-recommendation-form>
              </div>
            </div>
          </div>
        </size-recommendation-popup>
      </template>
    </div>
  </size-recommendation>
{% endif %}
{% schema %}
{
  "name": "t:sections.size_recommendation.name",
  "class": "my-custom block-size-recommendation",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.size_recommendation.how_to_use"
    },
    {
      "type": "paragraph",
      "content": "t:sections.size_recommendation.info"
    },
    {
      "type": "text",
      "id": "size_trigger",
      "label": "t:sections.all.product_setting.variant_picker.settings.size_guide.settings.size_trigger.label",
      "info": "t:sections.all.product_setting.variant_picker.settings.size_guide.settings.size_trigger.info",
      "default": "Size,Größe,Misurare,مقاس"
    },
    {
      "type": "header",
      "content": "Button settings"
    },
    {
      "type": "text",
      "id": "button_title",
      "label": "t:sections.all.content_setting.button_label-block.name",
      "default": "Find your fit assistant size"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button background color",
      "default": "#E7EAF6"
    },
    {
      "type": "header",
      "content": "Content in modal"
    },
    {
      "type": "richtext",
      "id": "policy_text",
      "label": "t:sections.size_recommendation.data_usage_notice.label",
      "info": "t:sections.size_recommendation.data_usage_notice.info",
      "default": "<p>By continuing, you agree to the use of your details for size recommendations. Privacy Policy.</p>"
    },
