{% liquid
  assign block_st = block.settings

  if block_st.layout == 'default'
    if block_st.number_position == 'after'
      assign class_layout_default = 'column-reverse'
    else
      assign class_layout_default = 'column'
    endif
  else
    assign class_layout_default = 'row align-center'
  endif
  if block_st.counter_style == 'circle'
    if block_st.number_position == 'after'
      assign class_layout_default = 'column-reverse'
    else
      assign class_layout_default = 'column'
    endif
  endif
%}

<style>
  .counter-number {
    font-variant-numeric: tabular-nums;
  }
  .counter-style-circle .counter-wrapper {
    display: flex;
    flex-direction: column;
  }
  .counter-style-circle .counter-number {
    font-size: 22px;
    text-anchor: middle;
    dominant-baseline: central;
  }
  .counter-style-circle .progress-circle {
    width: 150px;
    height: 150px;
    border-radius: 50%;
    background: conic-gradient(
      var(--stroke-color) 0 var(--progress-desktop),
      var(--indicator-color) var(--progress-desktop)
    );
  }
  .counter-style-circle .progress-circle::before {
    content: '';
    position: absolute;
    width: 134px;
    height: 134px;
    border-radius: 50%;
    background-color: var(--background-color);
    z-index: 1;
  }
  .counter-style-circle .progress-value {
    color: var(--stroke-color);
    font-size: 5rem;
    z-index: 2;
  }
  @media screen and (max-width: 767.98px) {
    .counter-style-circle .counter-number {
      font-size: 14px;
    }
    .counter-style-circle .progress-circle::before {
      width: 70px;
      height: 70px;
    }
    .counter-style-circle .progress-circle {
      width: 80px;
      height: 80px;
    }
  }
</style>
{% capture style %}
--space-bottom: {{ block_st.padding_bottom }};--space-top: {{ block_st.padding_top }};--space-left: 0;--space-right: 0;--space-min-left: 0;--space-min-right: 0;
{%- if block_st.padding_top > 20 -%}--space-min-top: {{ block_st.padding_top | times: 0.67 }};{%- else -%}--space-min-top: {{ block_st.padding_top }};{%- endif -%}
{%- if block_st.padding_bottom > 20 -%}--space-min-bottom: {{ block_st.padding_bottom | times: 0.67 }};{%- else -%}--space-min-bottom: {{ block_st.padding_bottom }};{%- endif -%}
--gap: {{ block_st.space_between }}px;
{% endcapture %}
<div
  class="flexible-block counter-container relative group-block--height switch-slide__mobile{% if request.visual_preview_mode %} bg-white p-sp-5 rounded-5 text-center{% else %} spacing-style{% endif %}"
  data-section-id="{{ section.id }}"
  style="{{ style | strip | strip_newlines }};"
  {{ block.shopify_attributes }}
>
  {% if block_st.counter_style == 'circle' %}
    <div class="flex {{ class_layout_default }} gap counter-style-circle align-{{ block_st.alignment }}">
      <counter-animation
        data-counter="{{ block_st.counter_value | default: 100 }}"
        data-start="{{ block_st.start_value | default: 0 }}"
        data-duration="{{ block_st.duration | default: 2000 }}"
        style="--progress-desktop: {{ block_st.counter_value | default: 100 }}%;--stroke-color: {{ block_st.stroke_color}};--background-color: {{ block_st.background_color }};--indicator-color: {{ block_st.indicator_color }};"
        class="progress-circle progress-circle relative content-center flex w-full{% if block_st.layout == 'default' %} column{% if block_st.number_position == 'after' %} column-reverse{% endif %}{% else %} row{% endif %}"
      >
        <span
          data-counter-target
          x="50%"
          y="50%"
          dominant-baseline="central"
          text-anchor="middle"
          class="counter-number progress-value relative"
        >
          {{ block_st.start_value | default: 0 }}
        </span>
      </counter-animation>
      <div
        class="counter-title {{ block_st.type_preset_text }}{% if block_st.type_preset_text == 'paragraph' %} text-color{% endif %}"
        style="{% if block_st.type_preset_text == 'paragraph' %}--color-text: {{ block_st.text_color }};{% else %}--color-heading: {{ block_st.text_color }};{% endif %}"
      >
        {{- block_st.title_text -}}
      </div>
    </div>
  {% else %}
    <counter-animation
      data-counter="{{ block_st.counter_value }}"
      data-start="{{ block_st.start_value }}"
      data-duration="{{ block_st.duration | default: 2000 }}"
      class="counter-wrapper flex gap w-full {{ class_layout_default }}"
    >
      <p
        class="counter-number text-{{ block_st.alignment }} {{ block_st.type_preset }}{% if request.visual_preview_mode %} h3 text-center{% endif %}"
        data-counter-target
        style="--color-heading: {{ block_st.stroke_color}};"
      >
        {{ block_st.start_value | default: 0 }}
      </p>
      <p
        class="counter-title {{ block_st.type_preset_text }}{% if block_st.type_preset_text == 'paragraph' %} text-color{% endif %}"
        style="{% if block_st.type_preset_text == 'paragraph' %}--color-text: {{ block_st.text_color }};{% else %}--color-heading: {{ block_st.text_color }};{% endif %}"
      >
        {{- block_st.title_text -}}
      </p>
    </counter-animation>
  {% endif %}
</div>

{% schema %}
{
