{% liquid
  assign block_st = block.settings
  assign custom_layout = block_st.custom_layout
  assign vertical_on_mobile = block_st.vertical_on_mobile

  assign horizontal_position = block_st.horizontal_position
  assign vertical_position = block_st.vertical_position
  assign horizontal_alignment = block_st.horizontal_alignment
  assign vertical_alignment = block_st.vertical_alignment
  if custom_layout == 'horizontal'
    assign content_wrap = block_st.content_wrap
    if content_wrap
      assign content_wrap = 'wrap'
    else
      assign content_wrap = 'flex-nowrap'
    endif
  endif
  if custom_layout == 'vertical'
    assign class_layout = 'column'
    case vertical_position
      when 'top'
        assign class_position = 'flex-start'
      when 'center'
        assign class_position = 'justify-center'
      when 'bottom'
        assign class_position = 'flex-end'
      when 'space_between'
        assign class_position = 'space-between'
    endcase
    case vertical_alignment
      when 'start'
        assign class_alignment = 'align-start'
      when 'center'
        assign class_alignment = 'align-center'
      when 'end'
        assign class_alignment = 'align-end'
    endcase
  else
    if vertical_on_mobile
      assign class_layout = 'row-1025 column'
      case horizontal_position
        when 'top'
          assign class_position = 'flex-start align-1025-start'
        when 'center'
          assign class_position = 'justify-center align-1025-center'
        when 'bottom'
          assign class_position = 'flex-end align-1025-end'
      endcase
      case horizontal_alignment
        when 'start'
          assign class_alignment = 'align-start flex-1025-start'
        when 'center'
          assign class_alignment = 'align-center flex-1025-center'
        when 'end'
          assign class_alignment = 'align-end flex-1025-end'
        when 'space_between'
          assign class_alignment = 'space-between'
      endcase
    else
      assign class_layout = 'row'
      case horizontal_position
        when 'top'
          assign class_position = 'align-start'
        when 'center'
          assign class_position = 'align-center'
        when 'bottom'
          assign class_position = 'align-end'
      endcase
      case horizontal_alignment
        when 'start'
          assign class_alignment = 'flex-start'
        when 'center'
          assign class_alignment = 'justify-center'
        when 'end'
          assign class_alignment = 'flex-end'
        when 'space_between'
          assign class_alignment = 'space-between'
      endcase
    endif
  endif

  assign inherit_color_scheme = block_st.inherit_color_scheme
  assign link_block = block_st.link_block
  assign open_in_new_tab = block_st.open_in_new_tab
  assign hidden_on_mobile = block_st.hidden_on_mobile
  assign background_media = block_st.background_media
  assign image_bg = block_st.image_bg
  assign video_local = block_st.video_local
  assign border_radius_type = block_st.border_radius_type
  assign border_radius_custom = block_st.border_radius_custom
  assign enable_background_overlay = block_st.enable_background_overlay
  assign border_style = block_st.border_style
  assign gap = block_st.gap
  if gap > 20
    assign min_gap = 20
  else
    assign min_gap = gap
  endif
%}
{% capture class %}
flexible-group flex row-gap gap {{ class_layout }} {{ class_alignment }} {{ class_position }} {{ content_wrap }} relative spacing-style w-full
{% endcapture %}
{%- capture style -%}
  --space-bottom: {{ block_st.padding_block }};--space-top: {{ block_st.padding_block }};--space-left: {{ block_st.padding_inline }};--space-right: {{ block_st.padding_inline }};
{%- if block_st.padding_inline > 20 -%}--space-min-left: 20;{%- else -%}--space-min-left: {{ block_st.padding_inline }};{%- endif -%}
{%- if block_st.padding_inline > 20 -%}--space-min-right: 20;{%- else -%}--space-min-right: {{ block_st.padding_inline }};{%- endif -%}
{%- if block_st.padding_block > 40 -%}--space-min-top: {{ block_st.padding_block | times: 0.67 }};{%- else -%}--space-min-top: {{ block_st.padding_block }};{%- endif -%}
{%- if block_st.padding_block > 40 -%}--space-min-bottom: {{ block_st.padding_block | times: 0.67 }};{%- else -%}--space-min-bottom: {{ block_st.padding_block }};{%- endif -%}
  {%- if block_st.height_block == 'adapt' -%}
    {%- if background_media == 'image' -%}
      {%- if image_bg != blank -%}
        --aspect-ratio: {{ image_bg.aspect_ratio }};
      {%- else -%}
        --aspect-ratio: 4/3;
      {%- endif -%}
    {%- elsif background_media == 'video' -%}
      {%- if video_local != blank -%}
        --aspect-ratio: {{ video_local.aspect_ratio }};
      {%- else -%}
        --aspect-ratio: 16/9;
      {%- endif -%}
    {%- endif -%}
  {%- endif -%}
  --gap: clamp(calc({{ min_gap }} * 1px),calc({{ min_gap }} * 1px + ({{ gap }} - {{ min_gap }}) * var(--responsive-rate)),calc({{ gap }} * 1px));--gap-desktop: clamp(calc({{ min_gap }} * 1px),calc({{ min_gap }} * 1px + ({{ gap }} - {{ min_gap }}) * var(--responsive-rate)),calc({{ gap }} * 1px));
  {%- if border_radius_type == 'custom' -%}--img-rounded: {{ border_radius_custom }}px;{%- endif -%}
  {%- if border_style == "solid" -%}
    --color-border: {{ block_st.border_color }};
    --border-height: {{ block_st.border_thickness }}px;
  {%- endif -%}
{%- endcapture -%}
<div
  class="flexible-block flexible-group--wrapper{% if hidden_on_mobile %} hidden flex-1025{% else %} flex{% endif %} group-block--height-{{ block_st.height_block }} group-block--width-{{ block_st.width_block }} group-block--width-mb-{{ block_st.width_block_mobile }}{% if border_style == "solid" %} border{% endif %}{% if inherit_color_scheme == false %} color-{{ block_st.color_scheme }}{% endif %} isolation gradient relative size-style{%- if border_radius_type == 'custom' %} rounded{% endif %}{% if link_block != blank %} hover-effect{% endif %} switch-slide__mobile"
  style="{{ style | strip | strip_newlines }};{% render 'size-style', settings: block_st, is_group: true %}"
  {{ block.shopify_attributes }}
>
  {% if link_block != blank %}
    <a
      href="{{ link_block }}"
      class="group-block__link absolute inset-0"
      {% if open_in_new_tab %}
        target="_blank" rel="noopener"
      {% endif %}
      aria-label="{{ 'products.product.view_full_details' | t }}"
    ></a>
  {% endif %}
  {% if background_media != 'none' %}
    {% render 'background-media', settings_bg: block_st %}
  {% endif %}
  {% if enable_background_overlay and background_media != 'none' %}
    {% render 'overlay', settings_overlay: block_st, layer: '0' %}
  {% endif %}
  <div class="{{ class }}">
    {% content_for 'blocks' %}
  </div>
</div>
