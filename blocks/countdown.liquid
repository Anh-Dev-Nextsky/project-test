{% liquid
  assign theme_st = settings
  assign block_st = block.settings
  assign scroll_animation = theme_st.scroll_animation
  if block_st.end_times != blank
    assign end_date_parts = block_st.end_times | split: '-'
    if end_date_parts.size == 3
      assign month = end_date_parts[0]
      assign day = end_date_parts[1]
      assign year = end_date_parts[2]
      assign formatted_date = year | append: '-' | append: month | append: '-' | append: day
      assign end_times = formatted_date | date: '%s'
      assign time_now = 'now' | date: '%s'
    else
      assign end_times = 0
      assign time_now = 1
    endif
  else
    assign end_times = 0
    assign time_now = 1
  endif
%}
{% capture style %}
--space-bottom: {{ block_st.padding_bottom }};--space-top: {{ block_st.padding_top }};--space-left: 0;--space-right: 0;--space-min-left: 0;--space-min-right: 0;
{%- if block_st.padding_top > 20 -%}--space-min-top: {{ block_st.padding_top | times: 0.67 }};{%- else -%}--space-min-top: {{ block_st.padding_top }};{%- endif -%}
{%- if block_st.padding_bottom > 20 -%}--space-min-bottom: {{ block_st.padding_bottom | times: 0.67 }};{%- else -%}--space-min-bottom: {{ block_st.padding_bottom }};{%- endif -%}
{% endcapture %}
<div
  class="flexible-block w-full flex justify-center{% if request.visual_preview_mode %} bg-white p-sp-5 rounded-5{% else %} spacing-style{% endif %}"
  data-section-id="{{ section.id }}"
  style="{{ style | strip | strip_newlines }};"
  {{ block.shopify_attributes }}
>
  {%- if scroll_animation != 'disable' -%}
    <motion-effect
      class="block"
    >
  {%- endif -%}
  {%- if end_times > time_now -%}
    <countdown-timer
      class="no-js-hidden flex gap wrap overflow-hidden text-color align-center flex-{{ block_st.alignment }} section_block {{ block_st.design }}"
      dir="auto"
      data-deadline="{{ block_st.end_times }}"
      data-days="{{ 'sections.countdown.format.days' | t }}"
      data-hours="{{ 'sections.countdown.format.hours' | t }}"
      data-mins="{{ 'sections.countdown.format.mins' | t }}"
      data-secs="{{ 'sections.countdown.format.secs' | t }}"
      data-message="{{ block_st.message }}"
      data-hidden="false"
      data-shape="{{ block_st.shape }}"
      data-border="{{ block_st.border_style }}"
      style="--gap: {{ block_st.spacing }}px;;--color-text: {{ block_st.color }};{% if block_st.design == 'modern' %}--color-bg: {{ block_st.background_color }};{% endif %}"
    >
      <div class="countdown-container lh-normal flex column relative bg-custom content-center">
        <span class="days_timer countdown-item">00</span>
        <span class="timer-announcementbar-text">{{ 'sections.countdown.format.days' | t }}</span>
      </div>
      <div class="countdown-container lh-normal flex column bg-custom relative content-center">
        <span class="hours_timer countdown-item">00</span>
        <span class="timer-announcementbar-text">{{ 'sections.countdown.format.hours' | t }}</span>
      </div>
      <div class="countdown-container lh-normal flex column bg-custom relative content-center">
        <span class="minutes_timer countdown-item">00</span>
        <span class="timer-announcementbar-text">{{ 'sections.countdown.format.mins' | t }}</span>
      </div>
      <div class="countdown-container lh-normal flex column bg-custom relative content-center">
        <span class="seconds_timer countdown-item">00</span>
        <span class="timer-announcementbar-text">{{ 'sections.countdown.format.secs' | t }}</span>
      </div>
    </countdown-timer>
  {%- else -%}
    <span>{{ block_st.message }}</span>
  {%- endif -%}
  {%- if scroll_animation != 'disable' -%}
    </motion-effect>
  {%- endif -%}
  <script src="{{ 'countdown-timer.js' | asset_url }}" defer="defer"></script>
</div>

{% schema %}
{
  "name": "t:sections.image-with-text-overlay.count_down",
  "class": "switch-slide__mobile group-block--height",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.image-with-text-overlay.how_to_use_count_down"
    },
    {
      "type": "text",
      "id": "end_times",
      "label": "t:sections.image-with-text-overlay.end_time.label",
      "info": "t:sections.image-with-text-overlay.end_time.info",
      "default": "11-20-2026"
    },
    {
      "type": "text",
      "id": "message",
      "label": "t:sections.image-with-text-overlay.message.label",
      "info": "t:sections.image-with-text-overlay.message.info",
      "default": "Timer expired"
    },
    {
      "type": "select",
      "id": "design",
      "label": "t:sections.main-password-content.blocks.countdown_bn.settings.countdown_design.label",
      "options": [
        {
          "value": "default",
          "label": "t:sections.main-password-content.blocks.countdown_bn.settings.countdown_design.options__1.label"
        },
        {
          "value": "modern",
          "label": "t:sections.main-password-content.blocks.countdown_bn.settings.countdown_design.options__2.label"
        }
      ],
      "default": "default"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:sections.custom_section.settings.layout.alignment.label_mobile",
      "options": [
        {
          "value": "start",
          "label": "t:sections.custom_section.settings.layout.alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.custom_section.settings.layout.alignment.options__2.label"
        },
        {
          "value": "end",
          "label": "t:sections.custom_section.settings.layout.alignment.options__3.label"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "spacing",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "label": "t:sections.all.padding.space_between",
      "default": 10
    },
    {
      "type": "color",
      "id": "color",
      "label": "t:sections.custom_section.blocks.social_icons.color",
      "default": "#000000",
      "alpha": true
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:sections.custom_section.blocks.social_icons.backgroup_color",
      "default": "#FFFFFF4D",
      "alpha": true,
      "visible_if": "{{ block.settings.design == 'modern' }}"
    },
    {
      "type": "header",
      "content": "t:sections.custom_section.blocks.page.spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 0
    }
  ],
  "presets": [
    { "name": "t:sections.image-with-text-overlay.count_down", "category": "t:sections.group.decorative.name" }
  ]
}
{% endschema %}
