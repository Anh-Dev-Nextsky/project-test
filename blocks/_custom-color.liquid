{% assign product_placement = product.metafields.custom.product_placement.value %}
{% if product_placement != blank %}
  <div class="custom-color-list w-full">
    {%- if block.settings.title != blank -%}
      <h3 id="custom-color-title-{{ block.id }}" class="color-title mb-3">{{ block.settings.title }}</h3>
    {%- else -%}
      <h3 id="custom-color-title-{{ block.id }}" class="visually-hidden">Select color</h3>
    {%- endif -%}

    <div
      class="color-options grid-cols grid gap"
      role="radiogroup"
      aria-labelledby="custom-color-title-{{ block.id }}"
      style="--col: 4;--gap: 12px;--gap-desktop: 16px;"
    >
      {%- for i in (1..10) -%}
        {%- assign color_image_key = 'color_' | append: i | append: '_image' -%}
        {%- assign color_name_key = 'color_' | append: i | append: '_name' -%}
        {%- assign color_image = block.settings[color_image_key] -%}
        {%- assign color_name = block.settings[color_name_key] -%}
        {%- if color_name != blank -%}
          {%- assign color_label = color_name -%}
        {%- else -%}
          {%- assign color_label = 'Color ' | append: i -%}
        {%- endif -%}

        {%- if color_image != blank or color_name != blank -%}
          <div class="color-option-item w-full">
            <label class="color-option-label block pointer relative h-full" for="custom-color-{{ block.id }}-{{ forloop.index }}">
              <input
                type="radio"
                id="custom-color-{{ block.id }}-{{ forloop.index }}"
                name="custom_color"
                class="absolute opacity-0"
                tabindex="0"
                value="{{ color_label }}"
                required
                aria-required="true"
                aria-label="{{ color_label | escape }}"
                data-color-index="{{ i }}"
              >

              <div class="color-option-content pointer">
                {%- if color_image != blank -%}
                  <div
                    class="color-option-image relative w-full h-full rounded-15 clip-path-unset relative overflow-hidden border"
                    style="--aspect-ratio: 1;"
                  >
                    {% render 'responsive-image',
                      type: 'other',
                      image: color_image,
                      image_alt: color_name,
                      class: 'w-full h-full object-cover rounded-15 overflow-hidden'
                    %}
                  </div>
                {% else %}
                  <div
                    class="color-option-image relative w-full h-full rounded-15 clip-path-unset relative overflow-hidden border"
                    style="--aspect-ratio: 1;"
                  >
                    {% render 'placeholder-render',
                      type: 'collection-6',
                      class: 'w-full h-full object-cover rounded-15 overflow-hidden',
                      motion: false
                    %}
                  </div>
                {%- endif -%}

                {%- if color_name != blank -%}
                  <div class="color-option-info mt-sp-2">
                    <h4 class="color-option-name heading-color text-size body_weight lh-global">{{ color_name }}</h4>
                  </div>
                {%- endif -%}
              </div>
            </label>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
{% endif %}
