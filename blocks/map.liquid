{% liquid
  assign block_st = block.settings
  assign location = block_st.location | url_encode
  assign latitude = block_st.latitude
  assign longitude = block_st.longitude
  assign border_radius_type = block_st.border_radius_type
  assign border_radius_custom = block_st.border_radius_custom
%}
{% capture style %}
{%- if border_radius_type == 'custom' %}--img-rounded: {{ border_radius_custom }}px;{% else %}--img-rounded: 0px;{% endif -%}
--item-height: {{ block_st.custom_height }}px;--space-bottom: {{ block_st.padding_bottom }};--space-top: {{ block_st.padding_top }};--space-left: 0;--space-right: 0;--space-min-left: 0;--space-min-right: 0;
{%- if block_st.padding_top > 20 -%}--space-min-top: {{ block_st.padding_top | times: 0.67 }};{%- else -%}--space-min-top: {{ block_st.padding_top }};{%- endif -%}
{%- if block_st.padding_bottom > 20 -%}--space-min-bottom: {{ block_st.padding_bottom | times: 0.67 }};{%- else -%}--space-min-bottom: {{ block_st.padding_bottom }};{%- endif -%}
{% endcapture %}

<div
  class="flexible-block map-block flex group-block--width-fill group-block--width-mb-fill w-full h-full spacing-style rounded switch-slide__mobile{% if request.visual_preview_mode %} bg-white px-sp-5 rounded-5{% endif %}"
  style="{{ style | strip | strip_newlines }}"
  {{ block.shopify_attributes }}
>
  {% if latitude != blank and longitude != blank %}
    <iframe
      class="map-iframe rounded"
      loading="lazy"
      allowfullscreen
      referrerpolicy="no-referrer-when-downgrade"
      src="https://maps.google.com/maps?q={{ latitude }},{{ longitude }}&z=15&output=embed"
    >
    </iframe>
  {% elsif location != blank %}
    <iframe
      class="map-iframe rounded"
      loading="lazy"
      allowfullscreen
      referrerpolicy="no-referrer-when-downgrade"
      src="https://maps.google.com/maps?q={{ location }}&z=15&output=embed"
    >
    </iframe>
  {% else %}
    <p>{{ 'google_map.no_iframe' | t }}</p>
  {% endif %}
</div>

{% stylesheet %}
  .map-iframe {
    width: 100%;
    height: 100%;
    min-height: var(--item-height);
    border: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.custom_section.blocks.map.name",
  "class": "w-full h-full",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.custom_section.blocks.map.how_to_use"
    },
    {
      "type": "text",
      "id": "location",
      "label": "t:sections.custom_section.blocks.map.location",
      "default": "New York"
    },
    {
      "type": "text",
      "id": "longitude",
      "label": "t:sections.custom_section.blocks.map.longitude",
      "default": "-74.005974"
    },
    {
      "type": "range",
      "id": "custom_height",
      "min": 100,
      "max": 1000,
      "step": 50,
      "unit": "px",
      "default": 400,
      "label": "t:sections.custom_section.settings.layout.height.custom_height.label"
    },
    {
      "type": "text",
      "id": "latitude",
      "label": "t:sections.custom_section.blocks.map.latitude",
      "default": "40.712776"
    },
    {
      "type": "select",
      "id": "border_radius_type",
      "label": "t:sections.custom_section.settings.appearance.settings.corner_radius.label",
      "options": [
        {
          "value": "none",
          "label": "t:sections.custom_section.settings.appearance.settings.corner_radius.options.none.label"
        },
        {
          "value": "custom",
          "label": "t:sections.custom_section.settings.appearance.settings.corner_radius.options.custom.label"
        }
      ]
    },
    {
      "type": "range",
      "id": "border_radius_custom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:sections.custom_section.settings.appearance.settings.corner_radius.custom_radius.label",
      "default": 20,
      "visible_if": "{{ block.settings.border_radius_type == 'custom' }}"
    },
    {
      "type": "header",
      "content": "t:sections.custom_section.blocks.page.spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:sections.custom_section.blocks.map.name",
      "category": "t:sections.group.decorative.name"
    }
  ]
}
{% endschema %}
