<div
  class="tab-heading transition pointer transition-all {{ block.settings.type_preset }} product-tabs__header-item z-1"
  data-target-content-id="template-content-{{ block.id }}"
  tabindex="0"
  aria-controls="tab-content-display"
  role="tab"
>
  <div class="transition pointer relative pb-sp-2 pb-1025-10 px-sp-6 px-1025-30 product-tabs__header-title">
    {{ block.settings.heading }}
  </div>
</div>

<template id="template-content-{{ block.id }}">
  {% content_for 'blocks' %}
</template>
{% schema %}
{
  "name": "t:sections.custom_section.blocks.tab.tab_row",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.custom_section.blocks.accordion.settings.settings.heading",
      "default": "t:sections.custom_section.blocks.accordion.settings.default_accordion_row"
    }
  ],
  "blocks": [
    {
      "type": "heading_block"
    },
    {
      "type": "text"
    },
    {
      "type": "button_block"
    },
    {
      "type": "image"
    },
    {
      "type": "video"
    },
    {
      "type": "highlight-text"
    },
    {
      "type": "icon"
    },
    {
      "type": "group"
    },
    {
      "type": "accordion"
    },
    {
      "type": "text-image-pairing"
    },
    {
      "type": "image-comparison"
    },
    {
      "type": "form-subscribe"
    },
    {
      "type": "form-contact"
    },
    {
      "type": "countdown"
    },
    {
      "type": "counter-up"
    },
    {
      "type": "popup-link"
    },
    {
      "type": "spacer"
    },
    {
      "type": "map"
    },
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "t:sections.custom_section.blocks.tab.tab_row",
      "blocks": {
        "text-1": {
          "type": "text",
          "settings": {
            "text": "<p>This product is crafted from comfortable, stretchy ripstop fabric, detailed with an oversized utility pocket and two zipped back pockets. The lightweight design offers optimal stretch and comfort for daily wear. It features a blend of 97% cotton and 3% elastane. Care Instructions: Machine wash cold, inside out.</p>",
            "text_align_desktop": "left",
            "text_align_mobile": "left"
          }
        }
      },
      "block_order": ["text-1"],
      "settings": {
        "heading": "Description"
      }
    }
  ]
}
{% endschema %}
