    "faqs_8y7kPB": {
      "type": "faqs",
      "blocks": {
        "item_faq_KpzL4w": {
          "type": "_item-faq",
          "settings": {
            "question": "Is Purity suitable for all skin types?",
            "answer": "<p>Our formulas are thoughtfully developed with gentle, skin-friendly ingredients suitable for most skin types, including sensitive skin. For highly reactive skin, we always recommend a patch test before first use.</p>"
          },
          "blocks": {}
        },
        "item_faq_b6gd3X": {
          "type": "_item-faq",
          "settings": {
            "question": "How do I build a routine?",
            "answer": "<p>We recommend starting with a simple three-step routine: cleanse, hydrate, and protect. You can gradually introduce targeted treatments like serums or exfoliants based on your specific skin concerns.</p>"
          },
          "blocks": {}
        },
        "item_faq_8RTGX6": {
          "type": "_item-faq",
          "settings": {
            "question": "Are the ingredients natural?",
            "answer": "<p>We prioritize high-quality, plant-derived ingredients whenever possible to ensure both safety and efficacy. While not 100% organic, our products perfectly balance nature and science for the best results.</p>"
          },
          "blocks": {}
        },
        "item_faq_qLRCPq": {
          "type": "_item-faq",
          "settings": {
            "question": "Can I mix products together?",
            "answer": "<p>Most of our products can be layered smoothly, but we advise against mixing them directly in your hand before application. To maintain maximum potency, apply each product one by one and let it absorb.</p>"
          },
          "blocks": {}
        },
        "item_faq_gbqJJR": {
          "type": "_item-faq",
          "name": "t:sections.faq.blocks.name",
          "settings": {
            "question": "Are your products cruelty-free?",
            "answer": "<p>Absolutely. We are deeply committed to ethical beauty, meaning none of our products or raw ingredients are ever tested on animals at any stage of development.</p>"
          },
          "blocks": {}
        }
      },
      "block_order": [
        "item_faq_KpzL4w",
